    "faq": {
      "type": "faq",
      "blocks": {
        "166442457738b23caf-0": {
          "type": "item",
          "settings": {
            "title": "VERSENDET IHR AUCH INS AUSLAND?",
            "content": "<p>Ja, wir versenden <strong>weltweit</strong> und innerhalb von Deutschland versandkostenfrei.</p><p>Bitte beachtet bei Bestellungen außerhalb der EU, dass der von uns  angegebene Produktpreis ohne Zoll und Steuern ist.  </p><p>Wir versenden über den Service DDU (Delivery Duty Unpaid). Die anfallenden Einfuhrumsatzsteuer sowie evtl. Zollgebühren werden Dir von dem Kurierdienst separat in Rechnung gestellt. Diese Kosten können von uns nicht abgeschätzt werden. Bitte setzt euch mit eurer zuständigen Zollbehörde in Verbindung.  </p>"
          }
        },
        "item_W4pJ8h": {
          "type": "item",
          "settings": {
            "title": "WIE MELDE ICH MICH ZUM NEWSLETTER AN?",
            "content": "<p>Danke! Wir freuen uns, dass du dich für unseren Socksletter interessierst!</p><p>Scrolle einfach auf unserer Startseite nach unten – dort kannst du dich für den Socksletter anmelden. Als Dankeschön schenken wir dir einen Gutscheincode mit einem Rabatt von bis zu <strong>30%</strong>.</p>"
          }
        },
        "166442457738b23caf-1": {
          "type": "item",
          "settings": {
            "title": "WIE LÖSE ICH MEINEN GUTSCHEIN EIN?",
            "content": "<p>Du kannst Deinen Gutschein im Warenkorb unter “Gutscheincode” eintragen und anschließend “Gutschein  anwenden” klicken.</p><p>Bitte beachte außerdem die individuellen Bedingungen, die für die jeweiligen Gutscheine oder Rabattcodes gelten. Diese stehen in der Regel im Sternchentext. </p>"
          }
        },
        "166442457738b23caf-2": {
          "type": "item",
          "settings": {
            "title": "WIE WASCHE ICH MEINE SOCKEN?",
            "content": "<p>Unsere bunten PATRON SOCKS Socken können bei <strong>40 Grad</strong> in der Waschmaschine gewaschen werden.</p><p>Wir empfehlen, Socken <strong>auf links zu waschen</strong>. Auf diese Weise werden Hautpartikel der Füße deutlich besser ausgespült. </p>"
          }
        },
        "item_DVd6M9": {
          "type": "item",
          "settings": {
            "title": "WANN IST MEINE GRÖSSE WIEDER VERFÜGBAR?",
            "content": "<p><strong>Wir versuchen immer  schnellstmöglich alle Größen anzubieten. Sollte Deine Größe ausnahmsweise nicht verfügbar sein, kannst Du uns gerne eine Email an die hello@patronsocks.de senden. Wir melden uns bei Dir sobald Deine Lieblingssocke wieder da ist.</strong></p>"
          }
        }
      },
      "block_order": [
        "166442457738b23caf-0",
        "item_W4pJ8h",
        "166442457738b23caf-1",
        "166442457738b23caf-2",
        "item_DVd6M9"
      ],
      "settings": {
        "full_width": true,
        "subheading": "",
        "title": "NOCH FRAGEN OFFEN?",
        "content": "<p>Falls Deine Frage hier nicht beantwortet wird, <strong>schreib uns gerne eine Mail</strong> und wir melden uns so schnell es geht bei Dir.</p>",
        "team_avatar": "shopify://shop_images/Petra-und-Leo-901x1024.png",
        "team_avatar_width": 250,
        "support_hours": "Du kannst uns jederzeit eine E-Mail schreiben oder unten auf das Kontaktformular klicken.",
        "answer_time": "Durchschn. Antwortzeit: 24h",
