    "rich_text_xQmgXx": {
      "type": "rich-text",
      "blocks": {
        "heading_TqpRnw": {
          "type": "heading",
          "settings": {
            "text": "SOCKEN FÜR DIE FLOSSEN!?",
            "heading_tag": "h1",
            "text_color": "#f01a26",
            "gradient": ""
          }
        },
        "richtext_frXyGf": {
          "type": "richtext",
          "settings": {
            "content": "<p>Als Kölner Unternehmen ist es uns eine Herzensangelegenheit einen Partner wie die <strong>Kölner Haie</strong> an der Seite zu haben. Gemeinsam bringen wir knallige <strong>Socken</strong> in exklusiver Qualität auf´s Eis. </p>"
          }
        }
      },
