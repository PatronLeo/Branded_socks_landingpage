{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} .patron-shell{width:min(var(--container-max-width),calc(100% - 40px));margin-inline:auto}
  #shopify-section-{{ section.id }} .patron-grid{display:grid;gap:var(--spacing-6)}
  #shopify-section-{{ section.id }} .patron-eyebrow{font-size:var(--text-xs);font-weight:700;letter-spacing:.12em;text-transform:uppercase}
  #shopify-section-{{ section.id }} .patron-muted{opacity:.68}
  #shopify-section-{{ section.id }} .patron-card{border:1px solid rgb(var(--text-color)/.12);border-radius:var(--rounded-lg);overflow:hidden}
  #shopify-section-{{ section.id }} .patron-media{position:relative;overflow:hidden;border-radius:var(--rounded-lg);min-height:420px}
  #shopify-section-{{ section.id }} .patron-media img,#shopify-section-{{ section.id }} .patron-media video{width:100%;height:100%;object-fit:cover;position:absolute;inset:0}
  @media screen and (max-width:699px){#shopify-section-{{ section.id }} .patron-shell{width:min(100% - 24px,var(--container-max-width))}}
</style>

<style>
#shopify-section-{{ section.id }} .patron-reference-grid{grid-template-columns:repeat(5,minmax(0,1fr));margin-top:var(--spacing-8)}
#shopify-section-{{ section.id }} .patron-reference-card{min-height:115px;padding:var(--spacing-5);display:flex;flex-direction:column;justify-content:center;text-align:center;transition:.2s ease}
#shopify-section-{{ section.id }} .patron-reference-card:hover{transform:translateY(-3px);box-shadow:0 18px 50px rgb(0 0 0/.08)}
#shopify-section-{{ section.id }} .patron-reference-card strong{font-size:var(--text-lg)}
#shopify-section-{{ section.id }} .patron-reference-card span{font-size:var(--text-xs);opacity:.65;margin-top:6px}
@media(max-width:999px){#shopify-section-{{ section.id }} .patron-reference-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:699px){#shopify-section-{{ section.id }} .patron-reference-grid{grid-template-columns:1fr 1fr}}
</style>
<div {% render 'section-properties' %}><div class="patron-shell">
 <div class="prose"><p class="subheading">{{ section.settings.subheading }}</p><h2 class="h2">{{ section.settings.title }}</h2>{{ section.settings.content }}</div>
 <div class="patron-grid patron-reference-grid">
 {% for block in section.blocks %}<div class="patron-card patron-reference-card" {{ block.shopify_attributes }}><strong>{{ block.settings.name }}</strong><span>{{ block.settings.category }}</span></div>{% endfor %}
 </div>
</div></div>
{% schema %}
{"name":"Patron – Referenzen","class":"shopify-section--patron-references","tag":"section","settings":[
{"type":"checkbox","id":"full_width","label":"Full width","default":true},{"type":"color","id":"background","label":"Background","default":"#ffffff"},{"type":"color","id":"text_color","label":"Text","default":"#121212"},
{"type":"text","id":"subheading","label":"Subheading","default":"Referenzen"},{"type":"text","id":"title","label":"Heading","default":"Bereits umgesetzt für starke Marken."},{"type":"richtext","id":"content","label":"Content","default":"<p>Echte Projekte schaffen sofort Vertrauen – direkt nach dem Hero.</p>"}],
"blocks":[{"type":"reference","name":"Reference","limit":8,"settings":[{"type":"text","id":"name","label":"Name","default":"MediaMarkt"},{"type":"text","id":"category","label":"Category","default":"Kundenaktionen"}]}],
"presets":[{"name":"Patron – Referenzen","blocks":[{"type":"reference","settings":{"name":"MediaMarkt","category":"Kundenaktionen · Weihnachten · WM"}},{"type":"reference","settings":{"name":"Mo-Torres","category":"Merchandise"}},{"type":"reference","settings":{"name":"Querbeat","category":"Band-Merchandise"}},{"type":"reference","settings":{"name":"Fortuna Köln","category":"Vereinssocken"}},{"type":"reference","settings":{"name":"Kölner Haie","category":"Vereinssocken"}}]}]}
{% endschema %}
