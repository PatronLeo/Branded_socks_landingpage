{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} .patronb2b-refs{
    background: {{ section.settings.background }};
    padding: 28px 0;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .patronb2b-refs__label{
    text-align: center;
    font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .03em;
    color: {{ section.settings.text_color }}; opacity: .6;
    margin-bottom: 18px;
  }
  #shopify-section-{{ section.id }} .patronb2b-refs__track{
    display: flex;
    width: max-content;
    animation: patronb2bMarquee {{ section.settings.speed }}s linear infinite;
  }
  #shopify-section-{{ section.id }} .patronb2b-refs__item{
    padding: 0 24px;
    display: flex; align-items: center; justify-content: center;
    min-width: 180px; height: 64px;
  }
  #shopify-section-{{ section.id }} .patronb2b-refs__item img{
    max-width: 140px; max-height: 64px; width: auto; height: auto; object-fit: contain;
    filter: {{ section.settings.logo_filter }};
  }
  #shopify-section-{{ section.id }} .patronb2b-refs__placeholder{
    width: 140px; height: 48px;
    border: 1px dashed rgba(255,255,255,.35);
    background: rgba(255,255,255,.06);
    display: flex; align-items: center; justify-content: center;
    color: rgba(255,255,255,.5);
    font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em;
  }
  @keyframes patronb2bMarquee{
    from{ transform: translateX(0); }
    to{ transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce){
    #shopify-section-{{ section.id }} .patronb2b-refs__track{ animation: none; flex-wrap: wrap; justify-content: center; }
  }
</style>

<div {% render 'section-properties' %}>
  <div class="patronb2b-refs">
    {%- if section.settings.label != blank -%}
      <div class="patronb2b-refs__label">{{ section.settings.label }}</div>
    {%- endif -%}
    <div class="patronb2b-refs__track">
      {%- for block in section.blocks -%}
        <div class="patronb2b-refs__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.name, widths: '160,280,400' }}
          {%- else -%}
            <div class="patronb2b-refs__placeholder" title="{{ block.settings.name }}">Logo</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
      {%- comment -%} Duplicate for seamless loop {%- endcomment -%}
      {%- for block in section.blocks -%}
        <div class="patronb2b-refs__item" aria-hidden="true">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: '', widths: '160,280,400' }}
          {%- else -%}
            <div class="patronb2b-refs__placeholder">Logo</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Patron B2B – Referenzen",
  "class": "shopify-section--patronb2b-refs",
  "tag": "section",
  "settings": [
    {"type": "checkbox", "id": "full_width", "label": "Full width", "default": true},
    {"type": "color", "id": "background", "label": "Background", "default": "#42195A"},
    {"type": "color", "id": "text_color", "label": "Text / logo color", "default": "#FFFFFF"},
    {"type": "text", "id": "label", "label": "Label", "default": "Bereits umgesetzt für starke Marken"},
    {"type": "range", "id": "speed", "label": "Marquee speed (seconds)", "min": 10, "max": 60, "step": 2, "default": 28, "unit": "s"},
    {"type": "text", "id": "logo_filter", "label": "Logo CSS filter", "info": "e.g. brightness(0) invert(1) to make logos white", "default": "brightness(0) invert(1)"}
  ],
  "blocks": [
    {
      "type": "reference",
      "name": "Reference",
      "limit": 12,
      "settings": [
        {"type": "text", "id": "name", "label": "Name", "default": "MediaMarkt"},
        {"type": "image_picker", "id": "image", "label": "Logo image (optional)"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Patron B2B – Referenzen",
      "blocks": [
        {"type": "reference", "settings": {"name": "MediaMarkt"}},
        {"type": "reference", "settings": {"name": "Mo-Torres"}},
        {"type": "reference", "settings": {"name": "Querbeat"}},
        {"type": "reference", "settings": {"name": "Fortuna Köln"}},
        {"type": "reference", "settings": {"name": "Kölner Haie"}}
      ]
    }
  ]
}
{% endschema %}
