{% comment %}
  PATRON SOCKS – Family Pack landing section
{% endcomment %}

{%- liquid
  assign section_gap = section.settings.section_gap
  assign content_width = section.settings.content_width
-%}

<section
  id="FamilyPackStory-{{ section.id }}"
  class="fp-story"
  style="
    --fp-section-gap: {{ section_gap }}px;
    --fp-content-width: {{ content_width }}px;
    --fp-purple: {{ section.settings.purple }};
    --fp-light-purple: {{ section.settings.light_purple }};
    --fp-green: {{ section.settings.green }};
    --fp-text: {{ section.settings.text_color }};
    --fp-background: {{ section.settings.background }};
  "
>
  <div class="fp-story__stack">

    <section class="fp-block fp-hero" aria-labelledby="fp-hero-title-{{ section.id }}">
      <div class="fp-container fp-hero__grid">
        <div class="fp-hero__content">
          <h2 id="fp-hero-title-{{ section.id }}" class="fp-display">
            {{ section.settings.hero_heading | escape | newline_to_br }}
          </h2>

          <div class="fp-richtext fp-hero__text">
            {{ section.settings.hero_text }}
          </div>
        </div>

        <div class="fp-hero__media">
          {%- if section.settings.hero_image != blank -%}
            {{
              section.settings.hero_image
              | image_url: width: 1800
              | image_tag:
                loading: 'lazy',
                widths: '480, 720, 960, 1200, 1600, 1800',
                sizes: '(min-width: 900px) 48vw, 100vw',
                class: 'fp-hero__image',
                alt: section.settings.hero_image.alt
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'fp-placeholder' }}
          {%- endif -%}
        </div>
      </div>
    </section>

    <section class="fp-block fp-steps" aria-labelledby="fp-steps-title-{{ section.id }}">
      <div class="fp-container">
        <h2 id="fp-steps-title-{{ section.id }}" class="fp-heading fp-heading--center">
          {{ section.settings.steps_heading | escape }}
        </h2>

        <div class="fp-steps__grid">
          {%- assign step_index = 0 -%}

          {%- for block in section.blocks -%}
            {%- if block.type == 'step' -%}
              {%- assign step_index = step_index | plus: 1 -%}

              <article class="fp-step" {{ block.shopify_attributes }}>
                <span class="fp-step__number">
                  {{ step_index }}
                </span>

                <div class="fp-step__icon" aria-hidden="true">
                  {%- if block.settings.custom_icon != blank -%}
                    {{
                      block.settings.custom_icon
                      | image_url: width: 180
                      | image_tag:
                        loading: 'lazy',
                        widths: '80, 120, 180',
                        sizes: '74px',
                        class: 'fp-step__custom-icon',
                        alt: ''
                    }}

                  {%- elsif block.settings.icon == 'heart' -%}
                    <svg viewBox="0 0 64 64" role="img">
                      <path d="M32 55 9.5 33.3C-3 21.2 5.5 5 19.5 9.1 25.1 10.7 29 15 32 19.5 35 15 38.9 10.7 44.5 9.1 58.5 5 67 21.2 54.5 33.3Z"/>
                    </svg>

                    {%- if block.settings.show_green_lines -%}
                      <span class="fp-heart-lines" aria-hidden="true">
                        <i></i>
                        <i></i>
                        <i></i>
                      </span>
                    {%- endif -%}

                  {%- else -%}
                    <svg viewBox="0 0 64 64" role="img">
                      <path d="M20 5h24v20c0 8 7 10 9 20 2 9-5 14-14 14H18C8 59 5 50 10 43l8-11V5h2Zm0 17h24M25 5v8m7-8v8m7-8v8"/>
                    </svg>
                  {%- endif -%}
                </div>

                <h3>{{ block.settings.heading | escape }}</h3>
                <p>{{ block.settings.text | escape }}</p>
              </article>

              {%- unless step_index == 3 -%}
                <div class="fp-step-arrow" aria-hidden="true">
                  <svg viewBox="0 0 72 24">
                    <path d="M2 12h64m-9-8 9 8-9 8"/>
                  </svg>
                </div>
              {%- endunless -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>

    <section class="fp-block fp-moments" aria-labelledby="fp-moments-title-{{ section.id }}">
      <div class="fp-container fp-moments__grid">
        <div class="fp-moments__media">
          {%- if section.settings.moments_image != blank -%}
            {{
              section.settings.moments_image
              | image_url: width: 1500
              | image_tag:
                loading: 'lazy',
                widths: '480, 720, 960, 1200, 1500',
                sizes: '(min-width: 900px) 48vw, 100vw',
                class: 'fp-moments__image',
                alt: section.settings.moments_image.alt
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'fp-placeholder' }}
          {%- endif -%}
        </div>

        <div class="fp-moments__content">
          <h2 id="fp-moments-title-{{ section.id }}" class="fp-heading">
            {{ section.settings.moments_heading | escape | newline_to_br }}
          </h2>

          <div class="fp-richtext">
            {{ section.settings.moments_text }}
          </div>
        </div>
      </div>
    </section>

    <section
      class="fp-block fp-founders"
      aria-labelledby="fp-founders-title-{{ section.id }}"
    >
      <div class="fp-container fp-founders__grid">

        <div class="fp-founders__content">
          <h2
            id="fp-founders-title-{{ section.id }}"
            class="fp-heading"
          >
            {{ section.settings.founders_heading | escape }}
          </h2>

          <div class="fp-richtext fp-founders__text">
            {{ section.settings.founders_text }}
          </div>
        </div>

        <div class="fp-founders__media">
          {%- if section.settings.founders_image != blank -%}
            {{
              section.settings.founders_image
              | image_url: width: 1500
              | image_tag:
                loading: 'lazy',
                widths: '480, 720, 960, 1200, 1500',
                sizes: '(min-width: 900px) 48vw, 100vw',
                class: 'fp-founders__image',
                alt: section.settings.founders_image.alt
            }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'fp-placeholder' }}
          {%- endif -%}
        </div>

      </div>
    </section>

    <section class="fp-block fp-benefits" aria-labelledby="fp-benefits-title-{{ section.id }}">
      <div class="fp-container">
        <h2 id="fp-benefits-title-{{ section.id }}" class="fp-heading fp-heading--center">
          {{ section.settings.benefits_heading | escape }}
        </h2>

        <div class="fp-benefits__grid">
          {%- for block in section.blocks -%}
            {%- if block.type == 'benefit' -%}
              <article class="fp-benefit" {{ block.shopify_attributes }}>
                <div class="fp-benefit__icon" aria-hidden="true">
                  {%- if block.settings.custom_icon != blank -%}
                    {{
                      block.settings.custom_icon
                      | image_url: width: 180
                      | image_tag:
                        loading: 'lazy',
                        widths: '80, 120, 180',
                        sizes: '72px',
                        class: 'fp-benefit__custom-icon',
                        alt: ''
                    }}
                  {%- else -%}
                    {%- case block.settings.icon -%}

                      {%- when 'cotton' -%}
                        <svg viewBox="0 0 80 80">
                          <path d="M40 67V47m0 12c-8 0-14-5-14-12 8 0 14 5 14 12Zm0 0c8 0 14-5 14-12-8 0-14 5-14 12ZM27 48c-10 0-18-8-18-18 0-9 7-17 16-18 4-7 13-10 21-7 6 2 10 7 11 13 9 1 15 8 15 17 0 10-8 18-18 18H27Z"/>
                        </svg>

                      {%- when 'heart' -%}
                        <svg viewBox="0 0 64 64">
                          <path d="M32 55 9.5 33.3C-3 21.2 5.5 5 19.5 9.1 25.1 10.7 29 15 32 19.5 35 15 38.9 10.7 44.5 9.1 58.5 5 67 21.2 54.5 33.3Z"/>
                        </svg>

                      {%- when 'shield' -%}
                        <svg viewBox="0 0 64 64">
                          <path d="M32 4 54 12v18c0 14-9 24-22 30C19 54 10 44 10 30V12Zm-9 27 6 6 13-14"/>
                        </svg>

                      {%- else -%}
                        <svg viewBox="0 0 80 80">
                          <path d="M18 12h20v18c0 7 6 9 8 17 2 8-4 13-12 13H17C8 60 5 52 9 46l7-10V12h2Zm25 10h17v15c0 6 5 8 7 15 1 7-4 11-11 11H42"/>
                        </svg>

                    {%- endcase -%}
                  {%- endif -%}
                </div>

                <h3>{{ block.settings.heading | escape }}</h3>
                <p>{{ block.settings.text | escape }}</p>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>

    <section class="fp-block fp-faq" aria-labelledby="fp-faq-title-{{ section.id }}">
      <div class="fp-container fp-container--narrow">
        <h2 id="fp-faq-title-{{ section.id }}" class="fp-heading fp-heading--center">
          {{ section.settings.faq_heading | escape }}
        </h2>

        <div class="fp-faq__list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'faq' -%}
              <details class="fp-faq__item" {{ block.shopify_attributes }}>
                <summary>
                  <span>{{ block.settings.question | escape }}</span>

                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m5 9 7 7 7-7"/>
                  </svg>
                </summary>

                <div class="fp-richtext fp-faq__answer">
                  {{ block.settings.answer }}
                </div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>

    <section class="fp-block fp-products" aria-labelledby="fp-products-title-{{ section.id }}">
      <div class="fp-container">
        <div class="fp-products__header">
          <h2 id="fp-products-title-{{ section.id }}" class="fp-heading fp-heading--center">
            {{ section.settings.products_heading | escape }}
          </h2>

          {%- if section.settings.products_link != blank and section.settings.products_link_text != blank -%}
            <a href="{{ section.settings.products_link }}" class="fp-products__link">
              {{ section.settings.products_link_text | escape }}
            </a>
          {%- endif -%}
        </div>

        <div class="fp-products__rail" role="list">
          {%- for product_item in section.settings.products -%}
            <article class="fp-product-card" role="listitem">
              <a href="{{ product_item.url }}" class="fp-product-card__image-link">
                {%- if product_item.featured_image != blank -%}
                  {{
                    product_item.featured_image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '240, 360, 540, 720, 900',
                      sizes: '(min-width: 1000px) 25vw, 72vw',
                      class: 'fp-product-card__image',
                      alt: product_item.featured_image.alt
                  }}
                {%- endif -%}
              </a>

              <h3>
                <a href="{{ product_item.url }}">
                  {{ product_item.title | escape }}
                </a>
              </h3>

              <p>{{ product_item.price | money }}</p>
            </article>

          {%- else -%}
            {%- for i in (1..4) -%}
              <article class="fp-product-card" role="listitem">
                {{ 'product-' | append: i | placeholder_svg_tag: 'fp-placeholder' }}
                <h3>Family Pack</h3>
                <p>{{ 3490 | money }}</p>
              </article>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
    </section>

  </div>
</section>

{% style %}
  #FamilyPackStory-{{ section.id }} {
    background: var(--fp-background);
    color: var(--fp-text);
    overflow: clip;
    font-family: var(--text-font-family, inherit);
  }

  #FamilyPackStory-{{ section.id }} * {
    box-sizing: border-box;
  }

  #FamilyPackStory-{{ section.id }} .fp-story__stack {
    display: flex;
    flex-direction: column;
  }

  #FamilyPackStory-{{ section.id }} .fp-block + .fp-block {
    margin-top: var(--fp-section-gap);
  }

  #FamilyPackStory-{{ section.id }} .fp-container {
    width: min(100% - 40px, var(--fp-content-width));
    margin-inline: auto;
  }

  #FamilyPackStory-{{ section.id }} .fp-container--narrow {
    max-width: 900px;
  }

  #FamilyPackStory-{{ section.id }} .fp-display,
  #FamilyPackStory-{{ section.id }} .fp-heading,
  #FamilyPackStory-{{ section.id }} h3,
  #FamilyPackStory-{{ section.id }} p {
    margin: 0;
  }

  #FamilyPackStory-{{ section.id }} .fp-display,
  #FamilyPackStory-{{ section.id }} .fp-heading,
  #FamilyPackStory-{{ section.id }} .fp-step h3,
  #FamilyPackStory-{{ section.id }} .fp-benefit h3 {
    font-family: var(--heading-font-family, inherit);
    font-weight: 800;
    text-transform: uppercase;
    color: var(--fp-purple);
    line-height: .98;
  }

  #FamilyPackStory-{{ section.id }} .fp-display {
    color: #fff;
    font-size: clamp(2rem, 4vw, 4.3rem);
    letter-spacing: -.035em;
  }

  #FamilyPackStory-{{ section.id }} .fp-heading {
    font-size: clamp(1.8rem, 3.2vw, 3.35rem);
    letter-spacing: -.02em;
  }

  #FamilyPackStory-{{ section.id }} .fp-heading--center {
    text-align: center;
  }

  #FamilyPackStory-{{ section.id }} .fp-richtext {
    line-height: 1.55;
  }

  #FamilyPackStory-{{ section.id }} .fp-richtext > * + * {
    margin-top: 1em;
  }

  #FamilyPackStory-{{ section.id }} .fp-hero {
    background: var(--fp-purple);
    color: #fff;
  }

  #FamilyPackStory-{{ section.id }} .fp-hero__grid {
    min-height: 380px;
    padding-block: clamp(32px, 4vw, 56px);
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(28px, 6vw, 96px);
  }

  #FamilyPackStory-{{ section.id }} .fp-hero__text {
    margin-top: 30px;
    max-width: 40ch;
    font-size: clamp(1rem, 1.4vw, 1.25rem);
  }

  #FamilyPackStory-{{ section.id }} .fp-hero__media {
    position: relative;
    min-width: 0;
  }

  #FamilyPackStory-{{ section.id }} .fp-hero__image,
  #FamilyPackStory-{{ section.id }} .fp-moments__image,
  #FamilyPackStory-{{ section.id }} .fp-founders__image,
  #FamilyPackStory-{{ section.id }} .fp-product-card__image {
    display: block;
    width: 100%;
    height: auto;
  }

  #FamilyPackStory-{{ section.id }} .fp-steps__grid {
    margin-top: clamp(34px, 5vw, 58px);
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: center;
    gap: clamp(16px, 3vw, 42px);
  }

  #FamilyPackStory-{{ section.id }} .fp-step {
    position: relative;
    text-align: center;
  }

  #FamilyPackStory-{{ section.id }} .fp-step__number {
    position: absolute;
    top: 0;
    left: calc(50% - 62px);
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--fp-green);
    color: var(--fp-purple);
    font-weight: 800;
  }

  #FamilyPackStory-{{ section.id }} .fp-step:last-child .fp-step__number {
    left: calc(50% - 78px);
  }

  #FamilyPackStory-{{ section.id }} .fp-step__icon {
    position: relative;
    width: 74px;
    height: 74px;
    margin-inline: auto;
    color: var(--fp-purple);
  }

  #FamilyPackStory-{{ section.id }} .fp-step__custom-icon {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #FamilyPackStory-{{ section.id }} .fp-step__icon svg,
  #FamilyPackStory-{{ section.id }} .fp-benefit__icon svg,
  #FamilyPackStory-{{ section.id }} .fp-step-arrow svg,
  #FamilyPackStory-{{ section.id }} .fp-faq summary svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #FamilyPackStory-{{ section.id }} .fp-heart-lines {
    position: absolute;
    top: -4px;
    right: -18px;
    width: 26px;
    height: 32px;
  }

  #FamilyPackStory-{{ section.id }} .fp-heart-lines i {
    position: absolute;
    width: 15px;
    height: 2px;
    background: var(--fp-green);
    transform-origin: left center;
  }

  #FamilyPackStory-{{ section.id }} .fp-heart-lines i:nth-child(1) {
    top: 5px;
    left: 4px;
    transform: rotate(-65deg);
  }

  #FamilyPackStory-{{ section.id }} .fp-heart-lines i:nth-child(2) {
    top: 14px;
    left: 9px;
    transform: rotate(-20deg);
  }

  #FamilyPackStory-{{ section.id }} .fp-heart-lines i:nth-child(3) {
    top: 24px;
    left: 9px;
    transform: rotate(20deg);
  }

  #FamilyPackStory-{{ section.id }} .fp-step h3 {
    margin-top: 18px;
    font-size: 1.15rem;
    line-height: 1.1;
  }

  #FamilyPackStory-{{ section.id }} .fp-step p {
    margin: 12px auto 0;
    max-width: 23ch;
    line-height: 1.45;
  }

  #FamilyPackStory-{{ section.id }} .fp-step-arrow {
    width: clamp(42px, 6vw, 72px);
    color: var(--fp-purple);
  }

  #FamilyPackStory-{{ section.id }} .fp-moments__grid,
  #FamilyPackStory-{{ section.id }} .fp-founders__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(36px, 7vw, 100px);
  }

  #FamilyPackStory-{{ section.id }} .fp-moments__content .fp-heading,
  #FamilyPackStory-{{ section.id }} .fp-founders__content .fp-heading {
    font-size: clamp(1.7rem, 2.6vw, 2.7rem);
  }

  #FamilyPackStory-{{ section.id }} .fp-moments__content .fp-richtext,
  #FamilyPackStory-{{ section.id }} .fp-founders__text {
    margin-top: 28px;
    font-size: clamp(1rem, 1.25vw, 1.2rem);
  }

  #FamilyPackStory-{{ section.id }} .fp-benefits {
    background: var(--fp-light-purple);
    padding-block: clamp(32px, 5vw, 58px);
  }

  #FamilyPackStory-{{ section.id }} .fp-benefits__grid {
    margin-top: 34px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  #FamilyPackStory-{{ section.id }} .fp-benefit {
    padding-inline: clamp(16px, 2.5vw, 34px);
    text-align: center;
  }

  #FamilyPackStory-{{ section.id }} .fp-benefit + .fp-benefit {
    border-left: 1px solid rgba(99, 43, 153, 0.22);
  }

  #FamilyPackStory-{{ section.id }} .fp-benefit__icon {
    width: 72px;
    height: 72px;
    margin-inline: auto;
    color: var(--fp-purple);
  }

  #FamilyPackStory-{{ section.id }} .fp-benefit__custom-icon {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #FamilyPackStory-{{ section.id }} .fp-benefit h3 {
    margin-top: 16px;
    font-size: 1rem;
    line-height: 1.1;
  }

  #FamilyPackStory-{{ section.id }} .fp-benefit p {
    margin-top: 10px;
    line-height: 1.45;
  }

  #FamilyPackStory-{{ section.id }} .fp-faq__list {
    margin-top: 28px;
    border-top: 1px solid #d8d8df;
  }

  #FamilyPackStory-{{ section.id }} .fp-faq__item {
    border-bottom: 1px solid #d8d8df;
  }

  #FamilyPackStory-{{ section.id }} .fp-faq summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-block: 15px;
    cursor: pointer;
    font-weight: 600;
  }

  #FamilyPackStory-{{ section.id }} .fp-faq summary::-webkit-details-marker {
    display: none;
  }

  #FamilyPackStory-{{ section.id }} .fp-faq summary svg {
    width: 20px;
    height: 20px;
    color: var(--fp-purple);
    transition: transform .2s ease;
  }

  #FamilyPackStory-{{ section.id }} .fp-faq details[open] summary svg {
    transform: rotate(180deg);
  }

  #FamilyPackStory-{{ section.id }} .fp-faq__answer {
    padding: 0 44px 18px 0;
  }

  #FamilyPackStory-{{ section.id }} .fp-products__header {
    position: relative;
  }

  #FamilyPackStory-{{ section.id }} .fp-products {
    padding-bottom: var(--fp-section-gap);
  }

  #FamilyPackStory-{{ section.id }} .fp-products__link {
    position: absolute;
    right: 0;
    bottom: 4px;
    color: var(--fp-purple);
    text-decoration: underline;
  }

  #FamilyPackStory-{{ section.id }} .fp-products__rail {
    margin-top: 30px;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(220px, 1fr);
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: 6px;
  }

  #FamilyPackStory-{{ section.id }} .fp-products__rail::-webkit-scrollbar {
    display: none;
  }

  #FamilyPackStory-{{ section.id }} .fp-product-card {
    min-width: 0;
    text-align: center;
    scroll-snap-align: start;
  }

  #FamilyPackStory-{{ section.id }} .fp-product-card__image-link {
    display: block;
    background: var(--fp-light-purple);
  }

  #FamilyPackStory-{{ section.id }} .fp-product-card h3 {
    margin-top: 14px;
    font-family: inherit;
    font-size: .95rem;
    text-transform: none;
    line-height: 1.3;
  }

  #FamilyPackStory-{{ section.id }} .fp-product-card h3 a {
    color: inherit;
    text-decoration: none;
  }

  #FamilyPackStory-{{ section.id }} .fp-product-card p {
    margin-top: 4px;
    color: var(--fp-purple);
    font-weight: 700;
  }

  #FamilyPackStory-{{ section.id }} .fp-placeholder {
    display: block;
    width: 100%;
    background: #eee;
  }

  @media screen and (max-width: 899px) {
    #FamilyPackStory-{{ section.id }} .fp-container {
      width: min(100% - 28px, var(--fp-content-width));
    }

    #FamilyPackStory-{{ section.id }} .fp-hero__grid,
    #FamilyPackStory-{{ section.id }} .fp-moments__grid,
    #FamilyPackStory-{{ section.id }} .fp-founders__grid {
      grid-template-columns: 1fr;
    }

    #FamilyPackStory-{{ section.id }} .fp-hero__grid {
      min-height: 0;
      padding-block: 32px;
    }

    #FamilyPackStory-{{ section.id }} .fp-hero__media {
      margin-top: 6px;
    }

    #FamilyPackStory-{{ section.id }} .fp-steps__grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    #FamilyPackStory-{{ section.id }} .fp-step-arrow {
      width: 46px;
      margin-inline: auto;
      transform: rotate(90deg);
    }

    #FamilyPackStory-{{ section.id }} .fp-step__number {
      left: calc(50% - 70px);
    }

    #FamilyPackStory-{{ section.id }} .fp-step:last-child .fp-step__number {
      left: calc(50% - 86px);
    }

    #FamilyPackStory-{{ section.id }} .fp-moments__content .fp-heading,
    #FamilyPackStory-{{ section.id }} .fp-founders__content .fp-heading {
      font-size: clamp(1.65rem, 8vw, 2.3rem);
    }

    #FamilyPackStory-{{ section.id }} .fp-moments__content {
      order: 2;
    }

    #FamilyPackStory-{{ section.id }} .fp-founders__media {
      order: 1;
    }

    #FamilyPackStory-{{ section.id }} .fp-founders__content {
      order: 2;
    }

    #FamilyPackStory-{{ section.id }} .fp-benefits__grid {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 34px;
    }

    #FamilyPackStory-{{ section.id }} .fp-benefit:nth-child(3) {
      border-left: 0;
    }

    #FamilyPackStory-{{ section.id }} .fp-products__header {
      padding-bottom: 24px;
    }

    #FamilyPackStory-{{ section.id }} .fp-products__link {
      left: 50%;
      right: auto;
      bottom: 0;
      transform: translateX(-50%);
      white-space: nowrap;
    }

    #FamilyPackStory-{{ section.id }} .fp-products__rail {
      grid-template-columns: none;
      grid-auto-columns: 72%;
    }
  }

  @media screen and (max-width: 560px) {
    #FamilyPackStory-{{ section.id }} .fp-benefits__grid {
      grid-template-columns: 1fr;
    }

    #FamilyPackStory-{{ section.id }} .fp-benefit + .fp-benefit {
      border-left: 0;
      border-top: 1px solid rgba(99, 43, 153, 0.22);
      padding-top: 28px;
    }

    #FamilyPackStory-{{ section.id }} .fp-products__rail {
      grid-auto-columns: 84%;
    }
  }
{% endstyle %}

