{%- comment -%}
  Retained for backwards compatibility. Section now renders the big-number
  stats row (Ab 100 Paar / 6 Wochen / 24 Std. / GOTS Bio). Use section
  "patron-b2b-stats" with display_style "numbers" for the same behavior on
  a fresh install; this section can be removed once the template is republished.
{%- endcomment -%}
{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} .patronb2b-nums-shell{
    max-width: var(--container-max-width, 1200px);
    margin: 0 auto;
    padding: 56px 24px;
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, 1fr);
    gap: 32px;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .patronb2b-nums__num{
    font-size: 30px; font-weight: 800; margin: 0;
    color: {{ section.settings.accent_color }};
  }
  #shopify-section-{{ section.id }} .patronb2b-nums__text{
    font-size: 14px; margin-top: 6px;
    color: {{ section.settings.text_color }}; opacity: .72;
  }
  @media screen and (max-width: 899px){
    #shopify-section-{{ section.id }} .patronb2b-nums-shell{ grid-template-columns: repeat(2,1fr); padding: 40px 20px; }
  }
  @media screen and (max-width: 499px){
    #shopify-section-{{ section.id }} .patronb2b-nums-shell{ grid-template-columns: 1fr; }
  }
</style>

<div {% render 'section-properties' %}>
  <div class="patronb2b-nums-shell">
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        <div class="patronb2b-nums__num">{{ block.settings.title }}</div>
        <div class="patronb2b-nums__text">{{ block.settings.text }}</div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Patron B2B – Kennzahlen",
  "class": "shopify-section--patronb2b-nums",
  "tag": "section",
  "settings": [
    {"type": "checkbox", "id": "full_width", "label": "Full width", "default": true},
    {"type": "color", "id": "background", "label": "Background", "default": "#F2F1F1"},
    {"type": "color", "id": "text_color", "label": "Text color", "default": "#1A1A1A"},
    {"type": "color", "id": "accent_color", "label": "Accent color", "default": "#632B99"}
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Number",
      "limit": 6,
      "settings": [
        {"type": "text", "id": "title", "label": "Big value", "default": "Ab 100 Paar"},
        {"type": "textarea", "id": "text", "label": "Description", "default": "Mindestbestellmenge, Großmengen möglich"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Patron B2B – Kennzahlen",
      "blocks": [
        {"type": "benefit", "settings": {"title": "Ab 100 Paar", "text": "Mindestbestellmenge, Großmengen möglich"}},
        {"type": "benefit", "settings": {"title": "6 Wochen", "text": "Produktionszeit"}},
        {"type": "benefit", "settings": {"title": "24 Std.", "text": "Kostenfreier erster Designvorschlag"}},
        {"type": "benefit", "settings": {"title": "GOTS Bio", "text": "Zertifizierte Baumwolle, optional"}}
      ]
    }
  ]
}
{% endschema %}
