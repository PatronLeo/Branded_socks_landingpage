{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} .patron-shell{width:min(var(--container-max-width),calc(100% - 40px));margin-inline:auto}
  #shopify-section-{{ section.id }} .patron-grid{display:grid;gap:var(--spacing-6)}
  #shopify-section-{{ section.id }} .patron-eyebrow{font-size:var(--text-xs);font-weight:700;letter-spacing:.12em;text-transform:uppercase}
  #shopify-section-{{ section.id }} .patron-muted{opacity:.68}
  #shopify-section-{{ section.id }} .patron-card{border:1px solid rgb(var(--text-color)/.12);border-radius:var(--rounded-lg);overflow:hidden}
  #shopify-section-{{ section.id }} .patron-media{position:relative;overflow:hidden;border-radius:var(--rounded-lg);min-height:420px}
  #shopify-section-{{ section.id }} .patron-media img,#shopify-section-{{ section.id }} .patron-media video{width:100%;height:100%;object-fit:cover;position:absolute;inset:0}
  @media screen and (max-width:699px){#shopify-section-{{ section.id }} .patron-shell{width:min(100% - 24px,var(--container-max-width))}}
</style>

<style>#shopify-section-{{ section.id }} .patron-contact{display:grid;grid-template-columns:.8fr 1.2fr;gap:var(--spacing-12);align-items:start}#shopify-section-{{ section.id }} .patron-contact__form{padding:var(--spacing-8);border-radius:var(--rounded-lg)}@media(max-width:999px){#shopify-section-{{ section.id }} .patron-contact{grid-template-columns:1fr}}</style>
<div id="patron-b2b-contact" {% render 'section-properties' %}><div class="patron-shell patron-contact"><div class="prose"><p class="subheading">{{ section.settings.subheading }}</p><h2 class="h2">{{ section.settings.title }}</h2>{{ section.settings.content }}<p><strong>Hinweis:</strong> Der native Shopify-Kontaktversand übermittelt keine Dateianhänge. Das Logo kann per WhatsApp oder über einen Drive-/WeTransfer-Link gesendet werden.</p></div><div {% render 'surface', class:'patron-contact__form', background:section.settings.form_background, text_color:section.settings.form_text_color, background_fallback:'bg-secondary' %}>{% form 'contact', class:'form' %}{% if form.posted_successfully? %}{% render 'banner', status:'success', content:'Vielen Dank! Wir melden uns persönlich bei euch.' %}{% endif %}{% if form.errors %}{% capture err %}{{ form.errors | default_errors }}{% endcapture %}{% render 'banner', status:'error', content:err %}{% endif %}<div class="fieldset"><div class="input-row">{% render 'input', type:'text', name:'contact[Unternehmensname]', label:'Unternehmensname', required:true %}{% render 'input', type:'text', name:'contact[Ansprechpartner]', label:'Ansprechpartner', required:true %}</div><div class="input-row">{% render 'input', type:'email', name:'contact[email]', label:'E-Mail', required:true %}{% capture qty %}<option value="" disabled selected></option><option>50–100</option><option>100–250</option><option>250–500</option><option>500–1.000</option><option>1.000+</option>{% endcapture %}{% render 'select', options:qty, name:'contact[Anzahl]', label:'Anzahl der Socken', required:true %}</div>{% capture purpose %}<option value="" disabled selected></option><option>Mitarbeitergeschenk</option><option>Kundengeschenk</option><option>Weihnachtsaktion</option><option>Messe / Event</option><option>Verein / Team</option><option>Merchandise</option><option>Geschenkset</option><option>Sonstiges</option>{% endcapture %}{% render 'select', options:purpose, name:'contact[Einsatzzweck]', label:'Geplanter Einsatzzweck', required:true %}{% render 'input', type:'url', name:'contact[Logo-Link]', label:'Logo-Link (Drive / WeTransfer)' %}{% render 'input', name:'contact[body]', label:'Kurze Projektbeschreibung (optional)', multiline:4 %}</div>{% render 'button', content:section.settings.button_label, type:'submit', size:'xl', stretch:true, background:section.settings.button_background, text_color:section.settings.button_text_color %}{% endform %}</div></div></div>
{% schema %}{"name":"Patron – Anfrage","class":"shopify-section--patron-contact","tag":"section","settings":[{"type":"checkbox","id":"full_width","label":"Full width","default":true},{"type":"color","id":"background","label":"Background","default":"#ffffff"},{"type":"color","id":"text_color","label":"Text","default":"#121212"},{"type":"text","id":"subheading","label":"Subheading","default":"Niedrigschwellige Anfrage"},{"type":"text","id":"title","label":"Heading","default":"Logo hochladen und kostenlos einen ersten Designvorschlag erhalten."},{"type":"richtext","id":"content","label":"Content","default":"<p>Unternehmensname, Ansprechpartner, Stückzahl und Einsatzzweck reichen für den ersten Kontakt.</p>"},{"type":"color","id":"form_background","label":"Form background","default":"#f2eee7"},{"type":"color","id":"form_text_color","label":"Form text","default":"#121212"},{"type":"text","id":"button_label","label":"Submit button","default":"Kostenlosen Designvorschlag erhalten"},{"type":"color","id":"button_background","label":"Button background","default":"#25d366"},{"type":"color","id":"button_text_color","label":"Button text","default":"#121212"}],"presets":[{"name":"Patron – Anfrage"}]}{% endschema %}
