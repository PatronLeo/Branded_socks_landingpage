{%- render 'section-spacing-collapsing' -%}
{%- liquid
  assign wa = section.settings.whatsapp_number | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')'
  capture wa_url
    echo 'https://wa.me/' | append: wa | append: '?text=' | append: section.settings.whatsapp_message | url_encode
  endcapture
  capture mail_url
    echo 'mailto:' | append: section.settings.contact_email | append: '?subject=' | append: section.settings.mail_subject | url_encode
  endcapture
-%}

<style>
  #shopify-section-{{ section.id }} .patronb2b-cnt-shell{
    max-width: var(--container-max-width, 1200px);
    margin: 0 auto;
    padding: 80px 24px;
    display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 56px;
  }
  #shopify-section-{{ section.id }} .patronb2b-cnt-eyebrow{
    font-size: 14px; font-weight: 700; letter-spacing: .03em; text-transform: uppercase;
    color: {{ section.settings.accent_color }}; margin-bottom: 8px;
  }
  #shopify-section-{{ section.id }} .patronb2b-cnt-title{
    font-size: 30px; font-weight: 800; margin: 0 0 16px;
    color: {{ section.settings.text_color }};
  }
  #shopify-section-{{ section.id }} .patronb2b-cnt-lead{
    font-size: 16px; line-height: 1.6; margin: 0 0 28px;
    color: {{ section.settings.text_color }}; opacity: .82;
  }
  #shopify-section-{{ section.id }} .patronb2b-cnt-card{
    background: {{ section.settings.tile_background }};
    border: 1px solid {{ section.settings.divider_color }};
    padding: 24px; margin-bottom: 24px;
  }
  #shopify-section-{{ section.id }} .patronb2b-cnt-card__title{
    font-size: 15px; font-weight: 700; margin: 0 0 8px;
    color: {{ section.settings.text_color }};
  }
  #shopify-section-{{ section.id }} .patronb2b-cnt-card__actions{
    display: flex; flex-wrap: wrap; gap: 12px;
  }
  #shopify-section-{{ section.id }} .patronb2b-cnt-btn{
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .03em;
    padding: 11px 22px; border: none; text-decoration: none; cursor: pointer;
    transition: filter .18s ease, background .18s, color .18s;
  }
  #shopify-section-{{ section.id }} .patronb2b-cnt-btn--primary{
    background: {{ section.settings.primary_btn_bg }};
    color: {{ section.settings.primary_btn_text }};
  }
  #shopify-section-{{ section.id }} .patronb2b-cnt-btn--primary:hover{ filter: brightness(.94); }
  #shopify-section-{{ section.id }} .patronb2b-cnt-btn--outline{
    background: transparent;
    color: {{ section.settings.accent_color }};
    border: 2px solid {{ section.settings.accent_color }};
  }
  #shopify-section-{{ section.id }} .patronb2b-cnt-btn--outline:hover{
    background: {{ section.settings.accent_color }}; color: #fff;
  }
  #shopify-section-{{ section.id }} .patronb2b-cnt-note{
    font-size: 13px; line-height: 1.5;
    color: {{ section.settings.text_color }}; opacity: .6;
  }
  #shopify-section-{{ section.id }} .patronb2b-cnt-form-wrap{
    background: {{ section.settings.form_background }};
    color: {{ section.settings.form_text_color }};
    padding: 32px;
  }
  #shopify-section-{{ section.id }} .patronb2b-form{ display: block; }
  #shopify-section-{{ section.id }} .patronb2b-form-row{
    display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;
  }
  #shopify-section-{{ section.id }} .patronb2b-form-field{ display: block; }
  #shopify-section-{{ section.id }} .patronb2b-form-field label{
    display: block; margin-bottom: 6px;
    font-size: 13px; font-weight: 700;
    color: {{ section.settings.form_text_color }};
  }
  #shopify-section-{{ section.id }} .patronb2b-form-field input,
  #shopify-section-{{ section.id }} .patronb2b-form-field select,
  #shopify-section-{{ section.id }} .patronb2b-form-field textarea{
    width: 100%; padding: 12px;
    border: 1px solid {{ section.settings.input_border }};
    background: {{ section.settings.input_background }};
    color: {{ section.settings.form_text_color }};
    font: inherit; font-size: 15px;
    box-sizing: border-box;
  }
  #shopify-section-{{ section.id }} .patronb2b-form-field textarea{ resize: vertical; }
  #shopify-section-{{ section.id }} .patronb2b-form-submit{
    display: inline-block; width: 100%;
    padding: 16px 24px; border: none; cursor: pointer;
    font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: .03em;
    background: {{ section.settings.primary_btn_bg }};
    color: {{ section.settings.primary_btn_text }};
    margin-top: 8px;
    transition: filter .18s ease;
  }
  #shopify-section-{{ section.id }} .patronb2b-form-submit:hover{ filter: brightness(.94); }
  #shopify-section-{{ section.id }} .patronb2b-form-msg{
    padding: 12px 14px; margin-bottom: 16px;
    background: rgba(0,0,0,.06);
    font-size: 14px;
  }
  #shopify-section-{{ section.id }} .patronb2b-form-msg--success{
    background: rgba(109, 217, 114, .22);
  }
  #shopify-section-{{ section.id }} .patronb2b-form-msg--error{
    background: rgba(220, 70, 70, .18);
  }
  @media screen and (max-width: 999px){
    #shopify-section-{{ section.id }} .patronb2b-cnt-shell{ grid-template-columns: 1fr; gap: 32px; padding: 56px 20px; }
    #shopify-section-{{ section.id }} .patronb2b-form-row{ grid-template-columns: 1fr; }
    #shopify-section-{{ section.id }} .patronb2b-cnt-title{ font-size: 24px; }
  }
</style>

<div id="patron-b2b-contact" {% render 'section-properties' %}>
  <div class="patronb2b-cnt-shell">
    <div>
      {%- if section.settings.subheading != blank -%}
        <div class="patronb2b-cnt-eyebrow">{{ section.settings.subheading | escape }}</div>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="patronb2b-cnt-title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.content != blank -%}
        <div class="patronb2b-cnt-lead">{{ section.settings.content | strip_html }}</div>
      {%- endif -%}

      <div class="patronb2b-cnt-card">
        <div class="patronb2b-cnt-card__title">{{ section.settings.card_title | default: 'Lieber direkt schreiben?' }}</div>
        <div class="patronb2b-cnt-card__actions">
          <a class="patronb2b-cnt-btn patronb2b-cnt-btn--primary" href="{{ wa_url }}" target="_blank" rel="noopener">
            {{ section.settings.whatsapp_label | default: 'Anfragen per WhatsApp' }}
          </a>
          <a class="patronb2b-cnt-btn patronb2b-cnt-btn--outline" href="{{ mail_url }}">
            {{ section.settings.mail_label | default: 'Anfragen per Mail' }}
          </a>
        </div>
      </div>

      <p class="patronb2b-cnt-note">{{ section.settings.note | default: 'Euer Logo lässt sich direkt in Google Drive oder WeTransfer teilen. Den Link könnt ihr im Kommentarfeld ergänzen oder per WhatsApp senden.' }}</p>
    </div>

    <div class="patronb2b-cnt-form-wrap">
      {%- form 'contact', class: 'patronb2b-form', id: 'patronb2b-contact-form' -%}
        {%- if form.posted_successfully? -%}
          <div class="patronb2b-form-msg patronb2b-form-msg--success">
            {{ section.settings.success_message | default: 'Danke! Wir melden uns persönlich bei euch.' }}
          </div>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="patronb2b-form-msg patronb2b-form-msg--error">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="patronb2b-form-row">
          <div class="patronb2b-form-field">
            <label for="patronb2b-company">Unternehmensname</label>
            <input id="patronb2b-company" type="text" name="contact[Unternehmensname]" placeholder="Eure Firma" required>
          </div>
          <div class="patronb2b-form-field">
            <label for="patronb2b-contact">Ansprechpartner</label>
            <input id="patronb2b-contact" type="text" name="contact[Ansprechpartner]" placeholder="Vor- und Nachname" required>
          </div>
        </div>

        <div class="patronb2b-form-field" style="margin-bottom:16px;">
          <label for="patronb2b-email">E-Mail</label>
          <input id="patronb2b-email" type="email" name="contact[email]" placeholder="name@firma.de" required>
        </div>

        <div class="patronb2b-form-row">
          <div class="patronb2b-form-field">
            <label for="patronb2b-quantity">Anzahl der Socken</label>
            <select id="patronb2b-quantity" name="contact[Anzahl]" required>
              <option value="100-250 Paar">100-250 Paar</option>
              <option value="250-500 Paar">250-500 Paar</option>
              <option value="500-1.000 Paar">500-1.000 Paar</option>
              <option value="1.000+ Paar">1.000+ Paar</option>
            </select>
          </div>
          <div class="patronb2b-form-field">
            <label for="patronb2b-purpose">Einsatzzweck</label>
            <select id="patronb2b-purpose" name="contact[Einsatzzweck]" required>
              <option value="Mitarbeitergeschenk">Mitarbeitergeschenk</option>
              <option value="Kundengeschenk">Kundengeschenk</option>
              <option value="Weihnachtsaktion">Weihnachtsaktion</option>
              <option value="Messe / Event">Messe / Event</option>
              <option value="Verein / Team">Verein / Team</option>
              <option value="Merchandise">Merchandise</option>
              <option value="Geschenkset">Geschenkset</option>
              <option value="Andere">Andere</option>
            </select>
          </div>
        </div>

        <div class="patronb2b-form-field" style="margin-bottom:16px;">
          <label for="patronb2b-logo">Logo-Link (Drive / WeTransfer)</label>
          <input id="patronb2b-logo" type="url" name="contact[Logo-Link]" placeholder="https://…">
        </div>

        <div class="patronb2b-form-field" style="margin-bottom:16px;">
          <label for="patronb2b-body">Kurze Projektbeschreibung (optional)</label>
          <textarea id="patronb2b-body" name="contact[body]" rows="3" placeholder="Anlass, Wunschtermin, Besonderheiten …"></textarea>
        </div>

        <button type="submit" class="patronb2b-form-submit">{{ section.settings.button_label | default: 'Kostenlosen Designvorschlag erhalten' }}</button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Patron B2B – Anfrage",
  "class": "shopify-section--patronb2b-contact",
  "tag": "section",
  "settings": [
    {"type": "checkbox", "id": "full_width", "label": "Full width", "default": true},
    {"type": "color", "id": "background", "label": "Section background", "default": "#FFFFFF"},
    {"type": "color", "id": "text_color", "label": "Text color", "default": "#1A1A1A"},
    {"type": "color", "id": "accent_color", "label": "Accent color", "default": "#632B99"},
    {"type": "color", "id": "tile_background", "label": "Card background", "default": "#FFFFFF"},
    {"type": "color", "id": "divider_color", "label": "Card border", "default": "#ECECEC"},
    {"type": "text", "id": "subheading", "label": "Eyebrow", "default": "Niedrigschwellige Anfrage"},
    {"type": "text", "id": "title", "label": "Heading", "default": "Logo hochladen und kostenlos einen ersten Designvorschlag erhalten."},
    {"type": "richtext", "id": "content", "label": "Lead", "default": "<p>Unternehmensname, Ansprechpartner, Stückzahl und Einsatzzweck reichen für den ersten Kontakt. Innerhalb von 24 Stunden meldet sich unser Team mit einem Designvorschlag.</p>"},
    {"type": "text", "id": "card_title", "label": "Card title", "default": "Lieber direkt schreiben?"},
    {"type": "text", "id": "note", "label": "Card note", "default": "Euer Logo lässt sich direkt in Google Drive oder WeTransfer teilen. Den Link könnt ihr im Kommentarfeld ergänzen oder per WhatsApp senden."},
    {"type": "header", "content": "Contact"},
    {"type": "text", "id": "contact_email", "label": "Contact email", "default": "hello@patronsocks.de"},
    {"type": "text", "id": "mail_subject", "label": "Mail subject", "default": "Werbesocken Anfrage"},
    {"type": "text", "id": "whatsapp_number", "label": "WhatsApp number", "default": "491627390598"},
    {"type": "textarea", "id": "whatsapp_message", "label": "WhatsApp message", "default": "Hallo Patron Socks, wir interessieren uns für individuelle Werbesocken und möchten einen kostenlosen ersten Designvorschlag erhalten."},
    {"type": "text", "id": "whatsapp_label", "label": "WhatsApp button label", "default": "Anfragen per WhatsApp"},
    {"type": "text", "id": "mail_label", "label": "Mail button label", "default": "Anfragen per Mail"},
    {"type": "header", "content": "Form"},
    {"type": "color", "id": "form_background", "label": "Form background", "default": "#F2F1F1"},
    {"type": "color", "id": "form_text_color", "label": "Form text color", "default": "#1A1A1A"},
    {"type": "color", "id": "input_background", "label": "Input background", "default": "#FFFFFF"},
    {"type": "color", "id": "input_border", "label": "Input border", "default": "#CCCCCC"},
    {"type": "text", "id": "button_label", "label": "Submit button label", "default": "Kostenlosen Designvorschlag erhalten"},
    {"type": "color", "id": "primary_btn_bg", "label": "Button background", "default": "#6DD972"},
    {"type": "color", "id": "primary_btn_text", "label": "Button text", "default": "#1A1A1A"},
    {"type": "text", "id": "success_message", "label": "Success message", "default": "Danke! Wir melden uns persönlich bei euch."}
  ],
  "presets": [{"name": "Patron B2B – Anfrage"}]
}
{% endschema %}
