{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} .patron-shell{width:min(var(--container-max-width),calc(100% - 40px));margin-inline:auto}
  #shopify-section-{{ section.id }} .patron-grid{display:grid;gap:var(--spacing-6)}
  #shopify-section-{{ section.id }} .patron-eyebrow{font-size:var(--text-xs);font-weight:700;letter-spacing:.12em;text-transform:uppercase}
  #shopify-section-{{ section.id }} .patron-muted{opacity:.68}
  #shopify-section-{{ section.id }} .patron-card{border:1px solid rgb(var(--text-color)/.12);border-radius:var(--rounded-lg);overflow:hidden}
  #shopify-section-{{ section.id }} .patron-media{position:relative;overflow:hidden;border-radius:var(--rounded-lg);min-height:420px}
  #shopify-section-{{ section.id }} .patron-media img,#shopify-section-{{ section.id }} .patron-media video{width:100%;height:100%;object-fit:cover;position:absolute;inset:0}
  @media screen and (max-width:699px){#shopify-section-{{ section.id }} .patron-shell{width:min(100% - 24px,var(--container-max-width))}}
</style>

<style>#shopify-section-{{ section.id }} .patron-gift{display:grid;grid-template-columns:.9fr 1.1fr;gap:var(--spacing-12);align-items:center}#shopify-section-{{ section.id }} .patron-layers{display:grid;gap:var(--spacing-3);padding:var(--spacing-8);background:#fff;border-radius:var(--rounded-lg);box-shadow:0 22px 70px rgb(0 0 0/.07)}#shopify-section-{{ section.id }} .patron-layer{padding:var(--spacing-5);border:1px solid rgb(18 18 18/.12);border-radius:var(--rounded);background:#f2eee7;font-weight:700;display:flex;justify-content:space-between}#shopify-section-{{ section.id }} .patron-layer:nth-child(even){margin-left:var(--spacing-6)}@media(max-width:999px){#shopify-section-{{ section.id }} .patron-gift{grid-template-columns:1fr}}</style>
<div {% render 'section-properties' %}><div class="patron-shell patron-gift"><div class="prose"><p class="subheading">{{ section.settings.subheading }}</p><h2 class="h2">{{ section.settings.title }}</h2>{{ section.settings.content }}{% render 'button', href:section.settings.link, content:section.settings.button_label, size:'xl', background:section.settings.button_background, text_color:section.settings.button_text_color %}</div><div class="patron-layers"><div class="patron-layer"><span>Individuelle Socken</span><span>01</span></div><div class="patron-layer"><span>Grußkarte / Anschreiben</span><span>02</span></div><div class="patron-layer"><span>Gutschein / Flyer</span><span>03</span></div><div class="patron-layer"><span>Weitere Werbemittel</span><span>04</span></div><div class="patron-layer"><span>Verpackung & Versand</span><span>05</span></div></div></div></div>
{% schema %}{"name":"Patron – Geschenksets","class":"shopify-section--patron-giftsets","tag":"section","settings":[{"type":"checkbox","id":"full_width","label":"Full width","default":true},{"type":"color","id":"background","label":"Background","default":"#f2eee7"},{"type":"color","id":"text_color","label":"Text","default":"#121212"},{"type":"text","id":"subheading","label":"Subheading","default":"Geschenksets & Konfektionierung"},{"type":"text","id":"title","label":"Heading","default":"Aus einem Produkt wird ein komplettes Geschenk."},{"type":"richtext","id":"content","label":"Content","default":"<p>Wir kombinieren individuelle Socken mit ausgewählten Beigaben, verpacken jedes Set und bereiten es für den Versand vor.</p>"},{"type":"text","id":"button_label","label":"Button","default":"Geschenkset anfragen"},{"type":"url","id":"link","label":"Link"},{"type":"color","id":"button_background","label":"Button background","default":"#121212"},{"type":"color","id":"button_text_color","label":"Button text","default":"#ffffff"}],"presets":[{"name":"Patron – Geschenksets"}]}{% endschema %}
