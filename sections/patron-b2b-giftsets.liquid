{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} .patronb2b-gift-shell{
    max-width: var(--container-max-width, 1200px);
    margin: 0 auto;
    padding: 80px 24px;
    display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center;
  }
  #shopify-section-{{ section.id }} .patronb2b-gift-eyebrow{
    font-size: 14px; font-weight: 700; letter-spacing: .03em; text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 8px;
  }
  #shopify-section-{{ section.id }} .patronb2b-gift-title{
    font-size: 30px; font-weight: 800; margin: 0 0 16px;
    color: {{ section.settings.text_color }};
  }
  #shopify-section-{{ section.id }} .patronb2b-gift-lead{
    font-size: 16px; line-height: 1.6; margin: 0 0 28px;
    color: {{ section.settings.text_color }}; opacity: .82;
  }
  #shopify-section-{{ section.id }} .patronb2b-gift-btn{
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: .03em;
    padding: 16px 32px; border: none; text-decoration: none; cursor: pointer;
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    transition: filter .18s ease;
  }
  #shopify-section-{{ section.id }} .patronb2b-gift-btn:hover{ filter: brightness(.94); }
  #shopify-section-{{ section.id }} .patronb2b-gift-list{
    display: flex; flex-direction: column; gap: 1px;
    background: {{ section.settings.divider_color }};
    border: 1px solid {{ section.settings.divider_color }};
  }
  #shopify-section-{{ section.id }} .patronb2b-gift-row{
    background: {{ section.settings.tile_background }};
    padding: 18px 22px;
    display: flex; align-items: center; gap: 16px;
  }
  #shopify-section-{{ section.id }} .patronb2b-gift-row__num{
    font-size: 14px; font-weight: 800;
    color: {{ section.settings.accent_color }};
    min-width: 24px;
  }
  #shopify-section-{{ section.id }} .patronb2b-gift-row__title{
    font-size: 15px; font-weight: 600;
    color: {{ section.settings.text_color }};
  }
  @media screen and (max-width: 999px){
    #shopify-section-{{ section.id }} .patronb2b-gift-shell{ grid-template-columns: 1fr; gap: 32px; padding: 56px 20px; }
    #shopify-section-{{ section.id }} .patronb2b-gift-title{ font-size: 24px; }
  }
</style>

<div {% render 'section-properties' %}>
  <div class="patronb2b-gift-shell">
    <div>
      {%- if section.settings.subheading != blank -%}
        <div class="patronb2b-gift-eyebrow">{{ section.settings.subheading | escape }}</div>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="patronb2b-gift-title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.content != blank -%}
        <div class="patronb2b-gift-lead">{{ section.settings.content | strip_html }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="patronb2b-gift-btn" href="{{ section.settings.link | default: '#patron-b2b-contact' }}">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
    <div class="patronb2b-gift-list">
      {%- for block in section.blocks -%}
        <div class="patronb2b-gift-row" {{ block.shopify_attributes }}>
          <div class="patronb2b-gift-row__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</div>
          <div class="patronb2b-gift-row__title">{{ block.settings.title }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Patron B2B – Geschenksets",
  "class": "shopify-section--patronb2b-giftsets",
  "tag": "section",
  "settings": [
    {"type": "checkbox", "id": "full_width", "label": "Full width", "default": true},
    {"type": "color", "id": "background", "label": "Background", "default": "#FFFFFF"},
    {"type": "color", "id": "text_color", "label": "Text color", "default": "#1A1A1A"},
    {"type": "color", "id": "accent_color", "label": "Accent color", "default": "#632B99"},
    {"type": "color", "id": "tile_background", "label": "Row background", "default": "#FFFFFF"},
    {"type": "color", "id": "divider_color", "label": "Divider color", "default": "#ECECEC"},
    {"type": "text", "id": "subheading", "label": "Eyebrow", "default": "Geschenksets & Konfektionierung"},
    {"type": "text", "id": "title", "label": "Heading", "default": "Aus einem Produkt wird ein komplettes Geschenk."},
    {"type": "richtext", "id": "content", "label": "Lead", "default": "<p>Wir kombinieren individuelle Socken mit ausgewählten Beigaben, verpacken jedes Set und bereiten es für den Versand vor.</p>"},
    {"type": "text", "id": "button_label", "label": "Button label", "default": "Geschenkset anfragen"},
    {"type": "url", "id": "link", "label": "Button link"},
    {"type": "color", "id": "button_background", "label": "Button background", "default": "#632B99"},
    {"type": "color", "id": "button_text_color", "label": "Button text", "default": "#FFFFFF"}
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "limit": 8,
      "settings": [
        {"type": "text", "id": "title", "label": "Title", "default": "Individuelle Socken"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Patron B2B – Geschenksets",
      "blocks": [
        {"type": "item", "settings": {"title": "Individuelle Socken"}},
        {"type": "item", "settings": {"title": "Grußkarte / Anschreiben"}},
        {"type": "item", "settings": {"title": "Gutschein / Flyer"}},
        {"type": "item", "settings": {"title": "Weitere Werbemittel"}},
        {"type": "item", "settings": {"title": "Verpackung & Versand"}}
      ]
    }
  ]
}
{% endschema %}
