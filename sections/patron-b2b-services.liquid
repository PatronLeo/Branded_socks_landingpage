{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} .patron-shell{width:min(var(--container-max-width),calc(100% - 40px));margin-inline:auto}
  #shopify-section-{{ section.id }} .patron-grid{display:grid;gap:var(--spacing-6)}
  #shopify-section-{{ section.id }} .patron-eyebrow{font-size:var(--text-xs);font-weight:700;letter-spacing:.12em;text-transform:uppercase}
  #shopify-section-{{ section.id }} .patron-muted{opacity:.68}
  #shopify-section-{{ section.id }} .patron-card{border:1px solid rgb(var(--text-color)/.12);border-radius:var(--rounded-lg);overflow:hidden}
  #shopify-section-{{ section.id }} .patron-media{position:relative;overflow:hidden;border-radius:var(--rounded-lg);min-height:420px}
  #shopify-section-{{ section.id }} .patron-media img,#shopify-section-{{ section.id }} .patron-media video{width:100%;height:100%;object-fit:cover;position:absolute;inset:0}
  @media screen and (max-width:699px){#shopify-section-{{ section.id }} .patron-shell{width:min(100% - 24px,var(--container-max-width))}}
</style>

<style>
#shopify-section-{{ section.id }} .patron-services{grid-template-columns:repeat(3,minmax(0,1fr));margin-top:var(--spacing-8)}
#shopify-section-{{ section.id }} .patron-service{padding:var(--spacing-7);min-height:220px}
#shopify-section-{{ section.id }} .patron-service h3{margin-top:var(--spacing-8)}#shopify-section-{{ section.id }} .patron-service p{opacity:.67;font-size:var(--text-sm)}
@media(max-width:999px){#shopify-section-{{ section.id }} .patron-services{grid-template-columns:1fr 1fr}}@media(max-width:699px){#shopify-section-{{ section.id }} .patron-services{grid-template-columns:1fr}}
</style>
<div {% render 'section-properties' %}><div class="patron-shell">
<div class="prose"><p class="subheading">{{ section.settings.subheading }}</p><h2 class="h2">{{ section.settings.title }}</h2>{{ section.settings.content }}</div>
<div class="patron-grid patron-services">{% for block in section.blocks %}<article class="patron-card patron-service" {{ block.shopify_attributes }}><span class="patron-eyebrow">0{{ forloop.index }}</span><h3 class="h4">{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></article>{% endfor %}</div>
</div></div>
{% schema %}{"name":"Patron – Leistungen","class":"shopify-section--patron-services","tag":"section","settings":[{"type":"checkbox","id":"full_width","label":"Full width","default":true},{"type":"color","id":"background","label":"Background","default":"#f2eee7"},{"type":"color","id":"text_color","label":"Text","default":"#121212"},{"type":"text","id":"subheading","label":"Subheading","default":"Das komplette Leistungspaket"},{"type":"text","id":"title","label":"Heading","default":"Eine Socke ist nur der Anfang."},{"type":"richtext","id":"content","label":"Content","default":"<p>Patron Socks begleitet B2B-Projekte von der Gestaltung bis zur Übergabe an einzelne Empfänger.</p>"}],"blocks":[{"type":"service","name":"Service","limit":12,"settings":[{"type":"text","id":"title","label":"Title","default":"Individuelle Firmensocken"},{"type":"textarea","id":"text","label":"Text","default":"Logo, Farben und Design passend zur Marke."}]}],"presets":[{"name":"Patron – Leistungen","blocks":[{"type":"service","settings":{"title":"Individuelle Firmensocken","text":"Logo, Farben und Design passend zur Marke."}},{"type":"service","settings":{"title":"Mitarbeiter- & Kundengeschenke","text":"Für Onboarding, Jubiläum, Weihnachten oder Dankeschön-Aktionen."}},{"type":"service","settings":{"title":"Messe- & Eventartikel","text":"Hochwertige Give-aways, Promotion- und Aktionsprodukte."}},{"type":"service","settings":{"title":"Vereins- & Teamsocken","text":"Für Mannschaft, Mitglieder, Fanshop und Sponsoren."}},{"type":"service","settings":{"title":"Geschenksets","text":"Mit Karten, Gutscheinen, Flyern und Werbemitteln."}},{"type":"service","settings":{"title":"Konfektionierung & Versand","text":"Fertig zusammengestellt und direkt an einzelne Empfänger."}}]}]}{% endschema %}
