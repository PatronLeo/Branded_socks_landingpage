{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} .patronb2b-svc-shell{
    max-width: var(--container-max-width, 1200px);
    margin: 0 auto;
    padding: 80px 24px;
  }
  #shopify-section-{{ section.id }} .patronb2b-svc-eyebrow{
    font-size: 14px; font-weight: 700; letter-spacing: .03em; text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 8px;
  }
  #shopify-section-{{ section.id }} .patronb2b-svc-title{
    font-size: 32px; font-weight: 800; margin: 0 0 12px; max-width: 640px;
    color: {{ section.settings.text_color }};
  }
  #shopify-section-{{ section.id }} .patronb2b-svc-lead{
    font-size: 16px; margin: 0 0 40px; max-width: 640px;
    color: {{ section.settings.text_color }}; opacity: .78;
  }
  #shopify-section-{{ section.id }} .patronb2b-svc-grid{
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: {{ section.settings.divider_color }};
    border: 1px solid {{ section.settings.divider_color }};
  }
  #shopify-section-{{ section.id }} .patronb2b-svc-tile{
    background: {{ section.settings.tile_background }};
    padding: 28px 24px;
    min-height: 160px;
  }
  #shopify-section-{{ section.id }} .patronb2b-svc-tile svg{
    width: 28px; height: 28px; display: block;
    margin-bottom: 14px;
    stroke: {{ section.settings.accent_color }};
    fill: none; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round;
  }
  #shopify-section-{{ section.id }} .patronb2b-svc-tile__title{
    font-size: 16px; font-weight: 700; line-height: 1.3;
    color: {{ section.settings.text_color }};
  }
  @media screen and (max-width: 999px){
    #shopify-section-{{ section.id }} .patronb2b-svc-grid{ grid-template-columns: repeat(2, 1fr); }
    #shopify-section-{{ section.id }} .patronb2b-svc-title{ font-size: 26px; }
  }
  @media screen and (max-width: 499px){
    #shopify-section-{{ section.id }} .patronb2b-svc-grid{ grid-template-columns: 1fr; }
    #shopify-section-{{ section.id }} .patronb2b-svc-shell{ padding: 56px 20px; }
  }
</style>

<div {% render 'section-properties' %}>
  <div class="patronb2b-svc-shell">
    {%- if section.settings.subheading != blank -%}
      <div class="patronb2b-svc-eyebrow">{{ section.settings.subheading | escape }}</div>
    {%- endif -%}
    {%- if section.settings.title != blank -%}
      <h2 class="patronb2b-svc-title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.content != blank -%}
      <p class="patronb2b-svc-lead">{{ section.settings.content | strip_html }}</p>
    {%- endif -%}
    <div class="patronb2b-svc-grid">
      {%- for block in section.blocks -%}
        <div class="patronb2b-svc-tile" {{ block.shopify_attributes }}>
          <span aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'tag' -%}
                <svg viewBox="0 0 24 24"><path d="M20.59 13.41 12 22l-9-9 8.59-8.59A2 2 0 0 1 13 4h6a1 1 0 0 1 1 1v6a2 2 0 0 1-.41 1.41Z"/><circle cx="15.5" cy="8.5" r="1.5"/></svg>
              {%- when 'gift' -%}
                <svg viewBox="0 0 24 24"><rect x="3" y="9" width="18" height="11" rx="1"/><path d="M12 9v11M3 13h18"/><path d="M12 9c-1.5 0-3-1-3-2.5S10.3 4 12 5.5 15 6.5 15 6.5 13.5 9 12 9Z"/></svg>
              {%- when 'star' -%}
                <svg viewBox="0 0 24 24"><path d="M12 2v20M12 2l3 3M12 2 9 5M4.9 7.5l14.2 9M4.9 7.5l3.9.6M4.9 7.5l1.2 3.7M19.1 16.5l-14.2-9M19.1 16.5l-3.9-.6M19.1 16.5l-1.2-3.7"/></svg>
              {%- when 'heart' -%}
                <svg viewBox="0 0 24 24"><path d="M20.8 8.6c0 4.4-8.8 10.9-8.8 10.9S3.2 13 3.2 8.6a4.6 4.6 0 0 1 8.8-1.8 4.6 4.6 0 0 1 8.8 1.8Z"/></svg>
              {%- when 'plane' -%}
                <svg viewBox="0 0 24 24"><path d="M3 11l17-7-7 17-2-8-8-2Z"/></svg>
              {%- when 'team' -%}
                <svg viewBox="0 0 24 24"><circle cx="8.5" cy="7.5" r="2.5"/><circle cx="16.5" cy="8.5" r="2"/><path d="M2 20c0-3 3-5.5 6.5-5.5S15 17 15 20M14 20c0-2.2 2-4 4.5-4S22 17.8 22 20"/></svg>
              {%- when 'package' -%}
                <svg viewBox="0 0 24 24"><path d="M3 8l9-5 9 5-9 5-9-5Z"/><path d="M3 8v8l9 5 9-5V8M12 13v8"/></svg>
              {%- when 'flyer' -%}
                <svg viewBox="0 0 24 24"><rect x="4" y="3" width="16" height="18" rx="1"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
              {%- when 'truck' -%}
                <svg viewBox="0 0 24 24"><path d="M3 7h11v10H3zM14 10h4l3 3v4h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>
              {%- when 'palette' -%}
                <svg viewBox="0 0 24 24"><path d="M12 3a9 9 0 1 0 0 18c1 0 1.7-.8 1.7-1.8 0-1-1-1.8-1-2.7 0-1 .8-1.5 1.7-1.5H16a5 5 0 0 0 5-5c0-3.9-4-7-9-7Z"/><circle cx="7.5" cy="10.5" r="1"/><circle cx="12" cy="7.5" r="1"/><circle cx="16.5" cy="10.5" r="1"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/></svg>
            {%- endcase -%}
          </span>
          <div class="patronb2b-svc-tile__title">{{ block.settings.title }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Patron B2B – Leistungen",
  "class": "shopify-section--patronb2b-services",
  "tag": "section",
  "settings": [
    {"type": "checkbox", "id": "full_width", "label": "Full width", "default": true},
    {"type": "color", "id": "background", "label": "Section background", "default": "#F2F1F1"},
    {"type": "color", "id": "text_color", "label": "Text color", "default": "#1A1A1A"},
    {"type": "color", "id": "accent_color", "label": "Accent color", "default": "#632B99"},
    {"type": "color", "id": "tile_background", "label": "Tile background", "default": "#FFFFFF"},
    {"type": "color", "id": "divider_color", "label": "Divider color", "default": "#ECECEC"},
    {"type": "text", "id": "subheading", "label": "Eyebrow", "default": "Das komplette Leistungspaket"},
    {"type": "text", "id": "title", "label": "Heading", "default": "Eine Socke ist nur der Anfang."},
    {"type": "richtext", "id": "content", "label": "Lead", "default": "<p>Patron Socks begleitet euer Projekt von der Gestaltung bis zur Übergabe an einzelne Empfänger – keine Socken, sondern eine komplette Geschenk- und Versandlösung.</p>"}
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "limit": 12,
      "settings": [
        {"type": "text", "id": "title", "label": "Title", "default": "Individuelle Socken mit Firmenlogo"},
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {"value": "tag", "label": "Tag"},
            {"value": "gift", "label": "Gift"},
            {"value": "star", "label": "Star"},
            {"value": "heart", "label": "Heart"},
            {"value": "plane", "label": "Plane"},
            {"value": "team", "label": "Team"},
            {"value": "package", "label": "Package"},
            {"value": "flyer", "label": "Flyer"},
            {"value": "truck", "label": "Truck"},
            {"value": "palette", "label": "Palette"}
          ],
          "default": "tag"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Patron B2B – Leistungen",
      "blocks": [
        {"type": "service", "settings": {"title": "Individuelle Socken mit Firmenlogo", "icon": "tag"}},
        {"type": "service", "settings": {"title": "Mitarbeitergeschenke", "icon": "gift"}},
        {"type": "service", "settings": {"title": "Weihnachtsgeschenke", "icon": "star"}},
        {"type": "service", "settings": {"title": "Kundengeschenke", "icon": "heart"}},
        {"type": "service", "settings": {"title": "Messe- und Eventartikel", "icon": "plane"}},
        {"type": "service", "settings": {"title": "Vereins- und Teamsocken", "icon": "team"}},
        {"type": "service", "settings": {"title": "Geschenksets", "icon": "package"}},
        {"type": "service", "settings": {"title": "Individuelle Produktbeigaben (Flyer, Gutscheine, Anschreiben)", "icon": "flyer"}}
      ]
    }
  ]
}
{% endschema %}
