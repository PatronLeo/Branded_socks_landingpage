{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} .patron-shell{width:min(var(--container-max-width),calc(100% - 40px));margin-inline:auto}
  #shopify-section-{{ section.id }} .patron-grid{display:grid;gap:var(--spacing-6)}
  #shopify-section-{{ section.id }} .patron-eyebrow{font-size:var(--text-xs);font-weight:700;letter-spacing:.12em;text-transform:uppercase}
  #shopify-section-{{ section.id }} .patron-muted{opacity:.68}
  #shopify-section-{{ section.id }} .patron-card{border:1px solid rgb(var(--text-color)/.12);border-radius:var(--rounded-lg);overflow:hidden}
  #shopify-section-{{ section.id }} .patron-media{position:relative;overflow:hidden;border-radius:var(--rounded-lg);min-height:420px}
  #shopify-section-{{ section.id }} .patron-media img,#shopify-section-{{ section.id }} .patron-media video{width:100%;height:100%;object-fit:cover;position:absolute;inset:0}
  @media screen and (max-width:699px){#shopify-section-{{ section.id }} .patron-shell{width:min(100% - 24px,var(--container-max-width))}}
</style>

<style>
#shopify-section-{{ section.id }} .patron-feature{display:grid;grid-template-columns:.9fr 1.1fr;margin-top:var(--spacing-8);background:#fff;color:#121212}
#shopify-section-{{ section.id }} .patron-feature__media{min-height:480px;position:relative}#shopify-section-{{ section.id }} .patron-feature__media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
#shopify-section-{{ section.id }} .patron-feature__copy{padding:clamp(32px,6vw,80px);display:flex;flex-direction:column;justify-content:center}
#shopify-section-{{ section.id }} .patron-case-grid{grid-template-columns:repeat(2,1fr);margin-top:var(--spacing-6)}
#shopify-section-{{ section.id }} .patron-case{display:grid;grid-template-columns:42% 58%;background:#fff;color:#121212;min-height:230px}#shopify-section-{{ section.id }} .patron-case__media{position:relative;min-height:230px}#shopify-section-{{ section.id }} .patron-case__media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}#shopify-section-{{ section.id }} .patron-case__copy{padding:var(--spacing-6);display:flex;flex-direction:column;justify-content:center}
@media(max-width:999px){#shopify-section-{{ section.id }} .patron-feature,#shopify-section-{{ section.id }} .patron-case{grid-template-columns:1fr}#shopify-section-{{ section.id }} .patron-case-grid{grid-template-columns:1fr}}
</style>
<div {% render 'section-properties' %}><div class="patron-shell">
<div class="prose"><p class="subheading">{{ section.settings.subheading }}</p><h2 class="h2">{{ section.settings.title }}</h2>{{ section.settings.content }}</div>
<article class="patron-card patron-feature"><div class="patron-feature__media">{% if section.settings.feature_image != blank %}{{ section.settings.feature_image | image_url:width:1400 | image_tag:loading:'lazy',sizes:'(max-width:999px) 100vw,45vw',widths:'600,900,1200,1400' }}{% else %}{{ 'product-1' | placeholder_svg_tag:'placeholder' }}{% endif %}</div><div class="patron-feature__copy prose"><p class="subheading">{{ section.settings.feature_category }}</p><h3 class="h2">{{ section.settings.feature_title }}</h3>{{ section.settings.feature_text }}<p><strong>Kundengeschenk · Weihnachtsaktion · WM-Kampagne</strong></p></div></article>
<div class="patron-grid patron-case-grid">{% for block in section.blocks %}<article class="patron-card patron-case" {{ block.shopify_attributes }}><div class="patron-case__media">{% if block.settings.image != blank %}{{ block.settings.image | image_url:width:900 | image_tag:loading:'lazy',sizes:'(max-width:999px) 100vw,22vw',widths:'400,600,900' }}{% else %}{{ 'product-2' | placeholder_svg_tag:'placeholder' }}{% endif %}</div><div class="patron-case__copy"><h3 class="h4">{{ block.settings.title }}</h3><p class="patron-muted">{{ block.settings.text }}</p></div></article>{% endfor %}</div>
</div></div>
{% schema %}{"name":"Patron – Projekte","class":"shopify-section--patron-projects","tag":"section","settings":[{"type":"checkbox","id":"full_width","label":"Full width","default":true},{"type":"color","id":"background","label":"Background","default":"#121212"},{"type":"color","id":"text_color","label":"Text","default":"#ffffff"},{"type":"text","id":"subheading","label":"Subheading","default":"Projekte nach Einsatzzweck"},{"type":"text","id":"title","label":"Heading","default":"Referenzen, die sofort Orientierung geben."},{"type":"richtext","id":"content","label":"Content","default":"<p>Unternehmen, Künstler und Vereine sehen direkt einen passenden Anwendungsfall.</p>"},{"type":"image_picker","id":"feature_image","label":"MediaMarkt image"},{"type":"text","id":"feature_category","label":"Category","default":"Kunden- & Weihnachtsaktion"},{"type":"text","id":"feature_title","label":"Title","default":"MediaMarkt"},{"type":"richtext","id":"feature_text","label":"Text","default":"<p>Individuelle Weihnachtssocken als Aktionsbeigabe zu MediaMarkt-Gutscheinen. Zusätzlich wurden für eine Fußball-WM passende Aktionssocken umgesetzt.</p>"}],"blocks":[{"type":"case","name":"Project","limit":8,"settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"title","label":"Title","default":"Mo-Torres"},{"type":"textarea","id":"text","label":"Text","default":"Merchandise-Socken für Fans und Verkauf."}]}],"presets":[{"name":"Patron – Projekte","blocks":[{"type":"case","settings":{"title":"Mo-Torres","text":"Merchandise-Socken für Fans und Verkauf."}},{"type":"case","settings":{"title":"Querbeat / Positiv Radikal","text":"Individuelle Band-Merchandise-Socken."}},{"type":"case","settings":{"title":"Fortuna Köln","text":"Vereinssocken für Fans, Mitglieder und Fanshop."}},{"type":"case","settings":{"title":"Kölner Haie","text":"Vereins- und Merchandise-Socken für den Eishockeyclub."}}]}]}{% endschema %}
