{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} .patronb2b-proj-shell{
    padding: 80px 0;
  }
  #shopify-section-{{ section.id }} .patronb2b-proj-header{
    max-width: var(--container-max-width, 1200px);
    margin: 0 auto 32px;
    padding: 0 24px;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .patronb2b-proj-eyebrow{
    font-size: 14px; font-weight: 700; letter-spacing: .03em; text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 8px;
  }
  #shopify-section-{{ section.id }} .patronb2b-proj-title{
    font-size: 34px; font-weight: 800; margin: 0 0 12px;
    color: {{ section.settings.text_color }};
    line-height: 1.15;
  }
  #shopify-section-{{ section.id }} .patronb2b-proj-content{
    max-width: 640px; margin: 0 auto;
    color: {{ section.settings.text_color }};
    opacity: .8;
  }

  #shopify-section-{{ section.id }} .patronb2b-proj-container{
    max-width: var(--container-max-width, 1200px);
    margin: 0 auto;
    padding: 0 24px;
  }

  #shopify-section-{{ section.id }} .patronb2b-proj-feature{
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 32px;
    align-items: center;
    background: {{ section.settings.placeholder_bg }};
    border-radius: 16px;
    padding: 24px;
    margin-bottom: 24px;
  }
  #shopify-section-{{ section.id }} .patronb2b-proj-feature__media{
    aspect-ratio: 1 / 1;
    background: #fff;
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .patronb2b-proj-feature__media img{
    width: 100%; height: 100%; object-fit: contain; padding: 24px; box-sizing: border-box;
  }
  #shopify-section-{{ section.id }} .patronb2b-proj-feature__cat{
    font-size: 13px; font-weight: 700; letter-spacing: .02em; text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 8px;
  }
  #shopify-section-{{ section.id }} .patronb2b-proj-feature__title{
    font-size: 32px; font-weight: 800; margin: 0 0 12px;
    color: {{ section.settings.text_color }};
    line-height: 1.1;
  }
  #shopify-section-{{ section.id }} .patronb2b-proj-feature__text{
    color: {{ section.settings.text_color }}; opacity: .85;
    font-size: 15px; line-height: 1.55;
  }

  #shopify-section-{{ section.id }} .patronb2b-proj-grid{
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  #shopify-section-{{ section.id }} .patronb2b-proj-tile{
    display: grid;
    grid-template-columns: minmax(0, 220px) minmax(0, 1fr);
    gap: 20px;
    align-items: center;
    background: {{ section.settings.placeholder_bg }};
    border-radius: 16px;
    padding: 16px;
  }
  #shopify-section-{{ section.id }} .patronb2b-proj-tile__media{
    aspect-ratio: 1 / 1;
    background: #fff;
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .patronb2b-proj-tile__media img{
    width: 100%; height: 100%; object-fit: contain; padding: 12px; box-sizing: border-box;
  }
  #shopify-section-{{ section.id }} .patronb2b-proj-tile__title{
    font-size: 20px; font-weight: 800; margin: 0 0 6px;
    color: {{ section.settings.text_color }};
    line-height: 1.2;
  }
  #shopify-section-{{ section.id }} .patronb2b-proj-tile__text{
    font-size: 14px;
    color: {{ section.settings.text_color }}; opacity: .7;
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .patronb2b-proj-rating{
    max-width: var(--container-max-width, 1200px);
    margin: 32px auto 0;
    padding: 0 24px;
    display: flex; align-items: center; justify-content: center; gap: 12px;
  }
  #shopify-section-{{ section.id }} .patronb2b-proj-rating__stars{
    color: {{ section.settings.star_color }};
    font-size: 18px; letter-spacing: 2px;
  }
  #shopify-section-{{ section.id }} .patronb2b-proj-rating__text{
    font-size: 14px; font-weight: 600;
    color: {{ section.settings.text_color }};
  }

  @media screen and (max-width: 767px){
    #shopify-section-{{ section.id }} .patronb2b-proj-title{ font-size: 26px; }
    #shopify-section-{{ section.id }} .patronb2b-proj-feature,
    #shopify-section-{{ section.id }} .patronb2b-proj-grid,
    #shopify-section-{{ section.id }} .patronb2b-proj-tile{
      grid-template-columns: 1fr;
    }
    #shopify-section-{{ section.id }} .patronb2b-proj-tile__media{
      max-width: 280px; margin: 0 auto;
    }
    #shopify-section-{{ section.id }} .patronb2b-proj-feature__title{ font-size: 24px; }
  }
</style>

<div {% render 'section-properties' %}>
  <div class="patronb2b-proj-shell">
    <div class="patronb2b-proj-header">
      {%- if section.settings.subheading != blank -%}
        <div class="patronb2b-proj-eyebrow">{{ section.settings.subheading | escape }}</div>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="patronb2b-proj-title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.content != blank -%}
        <div class="patronb2b-proj-content rte">{{ section.settings.content }}</div>
      {%- endif -%}
    </div>

    <div class="patronb2b-proj-container">
      {%- if section.settings.feature_image != blank or section.settings.feature_title != blank -%}
        <div class="patronb2b-proj-feature">
          <div class="patronb2b-proj-feature__media">
            {%- if section.settings.feature_image != blank -%}
              {{ section.settings.feature_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: section.settings.feature_title, widths: '400,600,800,1000,1200' }}
            {%- endif -%}
          </div>
          <div class="patronb2b-proj-feature__body">
            {%- if section.settings.feature_category != blank -%}
              <div class="patronb2b-proj-feature__cat">{{ section.settings.feature_category }}</div>
            {%- endif -%}
            {%- if section.settings.feature_title != blank -%}
              <h3 class="patronb2b-proj-feature__title">{{ section.settings.feature_title }}</h3>
            {%- endif -%}
            {%- if section.settings.feature_text != blank -%}
              <div class="patronb2b-proj-feature__text rte">{{ section.settings.feature_text }}</div>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      <div class="patronb2b-proj-grid">
        {%- for block in section.blocks -%}
          <div class="patronb2b-proj-tile" {{ block.shopify_attributes }}>
            <div class="patronb2b-proj-tile__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.title, widths: '220,440,600,800' }}
              {%- endif -%}
            </div>
            <div class="patronb2b-proj-tile__body">
              {%- if block.settings.title != blank -%}
                <div class="patronb2b-proj-tile__title">{{ block.settings.title }}</div>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="patronb2b-proj-tile__text">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.rating_text != blank -%}
      <div class="patronb2b-proj-rating">
        <span class="patronb2b-proj-rating__stars" aria-hidden="true">★★★★★</span>
        <span class="patronb2b-proj-rating__text">{{ section.settings.rating_text }}</span>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Patron B2B – Projekte",
  "class": "shopify-section--patronb2b-projects",
  "tag": "section",
  "settings": [
    {"type": "checkbox", "id": "full_width", "label": "Full width", "default": true},
    {"type": "color", "id": "background", "label": "Background", "default": "#FFFFFF"},
    {"type": "color", "id": "text_color", "label": "Text color", "default": "#1A1A1A"},
    {"type": "color", "id": "accent_color", "label": "Accent color", "default": "#632B99"},
    {"type": "color", "id": "placeholder_bg", "label": "Tile background", "default": "#F5F6F8"},
    {"type": "color", "id": "star_color", "label": "Star color", "default": "#6DD972"},
    {"type": "text", "id": "subheading", "label": "Eyebrow", "default": "Realisierte Projekte"},
    {"type": "text", "id": "title", "label": "Heading", "default": "Socken Liebe."},
    {"type": "richtext", "id": "content", "label": "Intro text"},
    {"type": "header", "content": "Featured Case (Hero-Karte)"},
    {"type": "image_picker", "id": "feature_image", "label": "Feature image"},
    {"type": "text", "id": "feature_category", "label": "Feature category", "default": "Kunden- & Weihnachtsaktion"},
    {"type": "text", "id": "feature_title", "label": "Feature title", "default": "MediaMarkt"},
    {"type": "richtext", "id": "feature_text", "label": "Feature text"},
    {"type": "header", "content": "Rating"},
    {"type": "text", "id": "rating_text", "label": "Rating text", "default": "Ausgezeichnet bewertet von Unternehmen, Vereinen und Künstlern"}
  ],
  "blocks": [
    {
      "type": "case",
      "name": "Case",
      "limit": 16,
      "settings": [
        {"type": "image_picker", "id": "image", "label": "Image", "info": "Empfohlen 1200×1200 quadratisch. Wird immer komplett angezeigt (kein Zuschnitt)."},
        {"type": "text", "id": "title", "label": "Title", "default": "Marke"},
        {"type": "text", "id": "text", "label": "Subtitle", "default": "Merchandise-Socken für Fans und Verkauf."}
      ]
    }
  ],
  "presets": [
    {
      "name": "Patron B2B – Projekte",
      "blocks": [
        {"type": "case", "settings": {"title": "Marke 1", "text": "Werbesocken für Mitarbeiter und Kunden"}},
        {"type": "case", "settings": {"title": "Marke 2", "text": "Merchandise-Socken für Fans und Verkauf."}},
        {"type": "case", "settings": {"title": "Marke 3", "text": "Merchandise-Socken für Fans und Verkauf."}},
        {"type": "case", "settings": {"title": "Marke 4", "text": "Merchandise-Socken für Fans und Verkauf."}}
      ]
    }
  ]
}
{% endschema %}
