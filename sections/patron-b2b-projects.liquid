{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} .patronb2b-proj-shell{
    padding: 80px 0;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .patronb2b-proj-header{
    max-width: var(--container-max-width, 1200px);
    margin: 0 auto;
    padding: 0 24px;
  }
  #shopify-section-{{ section.id }} .patronb2b-proj-eyebrow{
    font-size: 14px; font-weight: 700; letter-spacing: .03em; text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 8px;
  }
  #shopify-section-{{ section.id }} .patronb2b-proj-title{
    font-size: 30px; font-weight: 800; margin: 0 0 32px;
    color: {{ section.settings.text_color }};
  }
  #shopify-section-{{ section.id }} .patronb2b-proj-track{
    display: flex; width: max-content; gap: 16px;
    animation: patronb2bFilm {{ section.settings.speed }}s linear infinite;
    padding: 0 24px;
  }
  #shopify-section-{{ section.id }} .patronb2b-proj-item{
    width: 220px;
  }
  #shopify-section-{{ section.id }} .patronb2b-proj-item__media{
    position: relative; width: 220px; height: 220px; overflow: hidden;
    background: {{ section.settings.placeholder_bg }};
    display: flex; align-items: center; justify-content: center;
    color: {{ section.settings.text_color }}; opacity: .5;
    font-size: 13px; text-align: center;
  }
  #shopify-section-{{ section.id }} .patronb2b-proj-item__media img{
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
  }
  #shopify-section-{{ section.id }} .patronb2b-proj-item__tag{
    font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .03em;
    color: {{ section.settings.text_color }}; opacity: .6; margin-top: 8px;
  }
  #shopify-section-{{ section.id }} .patronb2b-proj-rating{
    max-width: var(--container-max-width, 1200px);
    margin: 32px auto 0;
    padding: 0 24px;
    display: flex; align-items: center; gap: 12px;
  }
  #shopify-section-{{ section.id }} .patronb2b-proj-rating__stars{
    color: {{ section.settings.star_color }};
    font-size: 18px; letter-spacing: 2px;
  }
  #shopify-section-{{ section.id }} .patronb2b-proj-rating__text{
    font-size: 14px; font-weight: 600;
    color: {{ section.settings.text_color }};
  }
  @keyframes patronb2bFilm{
    from{ transform: translateX(0); }
    to{ transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce){
    #shopify-section-{{ section.id }} .patronb2b-proj-track{ animation: none; flex-wrap: wrap; }
  }
  @media screen and (max-width: 699px){
    #shopify-section-{{ section.id }} .patronb2b-proj-title{ font-size: 24px; }
    #shopify-section-{{ section.id }} .patronb2b-proj-item,
    #shopify-section-{{ section.id }} .patronb2b-proj-item__media{ width: 180px; }
    #shopify-section-{{ section.id }} .patronb2b-proj-item__media{ height: 180px; }
  }
</style>

<div {% render 'section-properties' %}>
  <div class="patronb2b-proj-shell">
    <div class="patronb2b-proj-header">
      {%- if section.settings.subheading != blank -%}
        <div class="patronb2b-proj-eyebrow">{{ section.settings.subheading | escape }}</div>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="patronb2b-proj-title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
    </div>

    <div class="patronb2b-proj-track">
      {%- for block in section.blocks -%}
        <div class="patronb2b-proj-item" {{ block.shopify_attributes }}>
          <div class="patronb2b-proj-item__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: block.settings.tag, widths: '220,440,500' }}
            {%- else -%}
              <span>{{ block.settings.tag }}</span>
            {%- endif -%}
          </div>
          <div class="patronb2b-proj-item__tag">{{ block.settings.tag }}</div>
        </div>
      {%- endfor -%}
      {%- for block in section.blocks -%}
        <div class="patronb2b-proj-item" aria-hidden="true">
          <div class="patronb2b-proj-item__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: '', widths: '220,440,500' }}
            {%- else -%}
              <span>{{ block.settings.tag }}</span>
            {%- endif -%}
          </div>
          <div class="patronb2b-proj-item__tag">{{ block.settings.tag }}</div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.rating_text != blank -%}
      <div class="patronb2b-proj-rating">
        <span class="patronb2b-proj-rating__stars" aria-hidden="true">★★★★★</span>
        <span class="patronb2b-proj-rating__text">{{ section.settings.rating_text }}</span>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Patron B2B – Projekte",
  "class": "shopify-section--patronb2b-projects",
  "tag": "section",
  "settings": [
    {"type": "checkbox", "id": "full_width", "label": "Full width", "default": true},
    {"type": "color", "id": "background", "label": "Background", "default": "#FFFFFF"},
    {"type": "color", "id": "text_color", "label": "Text color", "default": "#1A1A1A"},
    {"type": "color", "id": "accent_color", "label": "Accent color", "default": "#632B99"},
    {"type": "color", "id": "placeholder_bg", "label": "Placeholder background", "default": "#F2F1F1"},
    {"type": "color", "id": "star_color", "label": "Star color", "default": "#6DD972"},
    {"type": "text", "id": "subheading", "label": "Eyebrow", "default": "Realisierte Projekte"},
    {"type": "text", "id": "title", "label": "Heading", "default": "Socken Liebe."},
    {"type": "range", "id": "speed", "label": "Speed (seconds)", "min": 15, "max": 80, "step": 2, "default": 32, "unit": "s"},
    {"type": "text", "id": "rating_text", "label": "Rating text", "default": "Ausgezeichnet bewertet von Unternehmen, Vereinen und Künstlern"}
  ],
  "blocks": [
    {
      "type": "case",
      "name": "Case",
      "limit": 16,
      "settings": [
        {"type": "image_picker", "id": "image", "label": "Image"},
        {"type": "text", "id": "tag", "label": "Tag / caption", "default": "Mitarbeitergeschenk"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Patron B2B – Projekte",
      "blocks": [
        {"type": "case", "settings": {"tag": "Mitarbeitergeschenk"}},
        {"type": "case", "settings": {"tag": "Weihnachtsaktion"}},
        {"type": "case", "settings": {"tag": "Vereinssocken"}},
        {"type": "case", "settings": {"tag": "Messe / Event"}},
        {"type": "case", "settings": {"tag": "Merchandise"}},
        {"type": "case", "settings": {"tag": "Geschenkset"}}
      ]
    }
  ]
}
{% endschema %}
