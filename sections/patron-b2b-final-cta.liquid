{%- render 'section-spacing-collapsing' -%}
{%- liquid
  assign wa = section.settings.whatsapp_number | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')'
  assign wa_msg = section.settings.whatsapp_message | url_encode
  assign wa_url = 'https://wa.me/' | append: wa | append: '?text=' | append: wa_msg
  assign mail_subject = section.settings.mail_subject | url_encode
  assign mail_url = 'mailto:' | append: section.settings.contact_email | append: '?subject=' | append: mail_subject
-%}

<style>
  #shopify-section-{{ section.id }} .patronb2b-fcta-shell{
    max-width: 700px;
    margin: 0 auto;
    padding: 72px 24px;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .patronb2b-fcta-eyebrow{
    font-size: 14px; font-weight: 700; letter-spacing: .03em; text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 12px;
  }
  #shopify-section-{{ section.id }} .patronb2b-fcta-title{
    font-size: 32px; font-weight: 800; margin: 0 0 16px;
    color: {{ section.settings.text_color }};
  }
  #shopify-section-{{ section.id }} .patronb2b-fcta-lead{
    font-size: 16px; margin: 0 0 32px;
    color: {{ section.settings.text_color }}; opacity: .82;
  }
  #shopify-section-{{ section.id }} .patronb2b-fcta-actions{
    display: flex; flex-wrap: wrap; justify-content: center; gap: 16px;
  }
  #shopify-section-{{ section.id }} .patronb2b-fcta-btn{
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: .03em;
    padding: 16px 32px; border: none; text-decoration: none; cursor: pointer;
    transition: filter .18s ease, background .18s, color .18s;
  }
  #shopify-section-{{ section.id }} .patronb2b-fcta-btn--primary{
    background: {{ section.settings.primary_btn_bg }};
    color: {{ section.settings.primary_btn_text }};
  }
  #shopify-section-{{ section.id }} .patronb2b-fcta-btn--primary:hover{ filter: brightness(.94); }
  #shopify-section-{{ section.id }} .patronb2b-fcta-btn--outline{
    background: transparent;
    color: {{ section.settings.text_color }};
    border: 2px solid {{ section.settings.text_color }};
  }
  #shopify-section-{{ section.id }} .patronb2b-fcta-btn--outline:hover{
    background: {{ section.settings.text_color }};
    color: {{ section.settings.background }};
  }
  @media screen and (max-width: 699px){
    #shopify-section-{{ section.id }} .patronb2b-fcta-title{ font-size: 24px; }
    #shopify-section-{{ section.id }} .patronb2b-fcta-shell{ padding: 56px 20px; }
  }
</style>

<div {% render 'section-properties' %}>
  <div class="patronb2b-fcta-shell">
    {%- if section.settings.subheading != blank -%}
      <div class="patronb2b-fcta-eyebrow">{{ section.settings.subheading | escape }}</div>
    {%- endif -%}
    {%- if section.settings.title != blank -%}
      <h2 class="patronb2b-fcta-title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.content != blank -%}
      <div class="patronb2b-fcta-lead">{{ section.settings.content | strip_html }}</div>
    {%- endif -%}
    <div class="patronb2b-fcta-actions">
      <a class="patronb2b-fcta-btn patronb2b-fcta-btn--primary" href="{{ wa_url }}" target="_blank" rel="noopener">
        {{ section.settings.whatsapp_label | default: 'Anfragen per WhatsApp' }}
      </a>
      <a class="patronb2b-fcta-btn patronb2b-fcta-btn--outline" href="{{ mail_url }}">
        {{ section.settings.mail_label | default: 'Anfragen per Mail' }}
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Patron B2B – Final CTA",
  "class": "shopify-section--patronb2b-fcta",
  "tag": "section",
  "settings": [
    {"type": "checkbox", "id": "full_width", "label": "Full width", "default": true},
    {"type": "color", "id": "background", "label": "Background", "default": "#42195A"},
    {"type": "color", "id": "text_color", "label": "Text color", "default": "#FFFFFF"},
    {"type": "color", "id": "accent_color", "label": "Accent color", "default": "#6DD972"},
    {"type": "text", "id": "subheading", "label": "Eyebrow", "default": "Von der Idee bis zum Versand"},
    {"type": "text", "id": "title", "label": "Heading", "default": "Schickt uns euer Logo. Wir machen daraus ein komplettes Projekt."},
    {"type": "richtext", "id": "content", "label": "Lead", "default": "<p>Design, Produktion, Verpackung, Konfektionierung und Versand aus einer Hand.</p>"},
    {"type": "header", "content": "Contact"},
    {"type": "text", "id": "contact_email", "label": "Contact email", "default": "hello@patronsocks.de"},
    {"type": "text", "id": "mail_subject", "label": "Mail subject", "default": "Werbesocken Anfrage"},
    {"type": "text", "id": "mail_label", "label": "Mail button label", "default": "Anfragen per Mail"},
    {"type": "text", "id": "whatsapp_number", "label": "WhatsApp number", "default": "491627390598"},
    {"type": "textarea", "id": "whatsapp_message", "label": "WhatsApp message", "default": "Hallo Patron Socks, wir interessieren uns für individuelle Werbesocken und möchten einen kostenlosen ersten Designvorschlag erhalten."},
    {"type": "text", "id": "whatsapp_label", "label": "WhatsApp button label", "default": "Anfragen per WhatsApp"},
    {"type": "color", "id": "primary_btn_bg", "label": "Primary button background", "default": "#6DD972"},
    {"type": "color", "id": "primary_btn_text", "label": "Primary button text", "default": "#1A1A1A"}
  ],
  "presets": [{"name": "Patron B2B – Final CTA"}]
}
{% endschema %}
