{%- render 'section-spacing-collapsing' -%}
{%- liquid
  assign wa = section.settings.whatsapp_number | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')'
  capture wa_url
    echo 'https://wa.me/' | append: wa | append: '?text=' | append: section.settings.whatsapp_message | url_encode
  endcapture
  capture mail_subject
    echo section.settings.mail_subject | url_encode
  endcapture
  capture mail_url
    echo 'mailto:' | append: section.settings.contact_email | append: '?subject=' | append: mail_subject
  endcapture
-%}

<style>
  #shopify-section-{{ section.id }} .patronb2b-hero-shell{
    max-width: var(--container-max-width, 1200px);
    margin: 0 auto;
    padding: 56px 24px 0;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: center;
  }
  #shopify-section-{{ section.id }} .patronb2b-hero-eyebrow{
    font-size: 14px; font-weight: 700; letter-spacing: .03em; text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 16px;
  }
  #shopify-section-{{ section.id }} .patronb2b-hero-title{
    font-size: 48px; line-height: 1.08; font-weight: 800; margin: 0 0 24px;
    color: {{ section.settings.text_color }};
  }
  #shopify-section-{{ section.id }} .patronb2b-hero-lead{
    font-size: 17px; line-height: 1.6; color: {{ section.settings.text_color }};
    opacity: .82; margin: 0 0 32px; max-width: 520px;
  }
  #shopify-section-{{ section.id }} .patronb2b-hero-actions{
    display: flex; flex-wrap: wrap; gap: 16px; margin-bottom: 24px;
  }
  #shopify-section-{{ section.id }} .patronb2b-btn{
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: .03em;
    padding: 16px 32px; border: none; cursor: pointer; text-decoration: none;
    transition: filter .18s ease, background .18s ease, color .18s ease;
  }
  #shopify-section-{{ section.id }} .patronb2b-btn--primary{
    background: {{ section.settings.primary_btn_bg }};
    color: {{ section.settings.primary_btn_text }};
  }
  #shopify-section-{{ section.id }} .patronb2b-btn--primary:hover{ filter: brightness(.94); }
  #shopify-section-{{ section.id }} .patronb2b-btn--outline{
    background: transparent;
    color: {{ section.settings.accent_color }};
    border: 2px solid {{ section.settings.accent_color }};
  }
  #shopify-section-{{ section.id }} .patronb2b-btn--outline:hover{
    background: {{ section.settings.accent_color }};
    color: #fff;
  }
  #shopify-section-{{ section.id }} .patronb2b-hero-trust{
    display: flex; flex-wrap: wrap; gap: 20px;
    font-size: 14px; font-weight: 600;
    color: {{ section.settings.text_color }}; opacity: .8;
  }
  #shopify-section-{{ section.id }} .patronb2b-hero-media{
    position: relative; width: 100%; aspect-ratio: 16/10;
    background: {{ section.settings.media_bg }};
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .patronb2b-hero-media img,
  #shopify-section-{{ section.id }} .patronb2b-hero-media video{
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
  }
  #shopify-section-{{ section.id }} .patronb2b-hero-media__dashed{
    position: absolute; inset: 12px;
    border: 2px dashed rgba(255,255,255,.35);
    pointer-events: none; z-index: 2;
  }
  #shopify-section-{{ section.id }} .patronb2b-hero-media__placeholder{
    position: relative; z-index: 3;
    display: flex; flex-direction: column; align-items: center; gap: 16px; color: #fff;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .patronb2b-hero-media__play{
    width: 72px; height: 72px; border-radius: 50%;
    background: rgba(255,255,255,.15);
    display: flex; align-items: center; justify-content: center;
    animation: patronb2bPulse 2s infinite;
  }
  #shopify-section-{{ section.id }} .patronb2b-hero-media__play svg{ margin-left: 4px; }
  #shopify-section-{{ section.id }} .patronb2b-hero-media__label{
    font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: .03em;
  }
  #shopify-section-{{ section.id }} .patronb2b-hero-media__note{
    font-size: 13px; color: rgba(255,255,255,.65); max-width: 280px;
  }
  @keyframes patronb2bPulse{
    0%{ box-shadow: 0 0 0 0 rgba(255,255,255,.5); }
    100%{ box-shadow: 0 0 0 14px rgba(255,255,255,0); }
  }
  @media screen and (max-width: 999px){
    #shopify-section-{{ section.id }} .patronb2b-hero-shell{ grid-template-columns: 1fr; gap: 32px; padding: 40px 20px 0; }
    #shopify-section-{{ section.id }} .patronb2b-hero-title{ font-size: 34px; }
    #shopify-section-{{ section.id }} .patronb2b-hero-media{ aspect-ratio: 4/3; }
  }
</style>

<div {% render 'section-properties' %}>
  <div class="patronb2b-hero-shell">
    <div>
      {%- if section.settings.subheading != blank -%}
        <div class="patronb2b-hero-eyebrow">{{ section.settings.subheading | escape }}</div>
      {%- endif -%}
      <h1 class="patronb2b-hero-title">{{ section.settings.title | escape }}</h1>
      {%- if section.settings.content != blank -%}
        <div class="patronb2b-hero-lead">{{ section.settings.content | strip_html }}</div>
      {%- endif -%}
      <div class="patronb2b-hero-actions">
        <a class="patronb2b-btn patronb2b-btn--primary" href="{{ wa_url }}" target="_blank" rel="noopener">
          {{ section.settings.whatsapp_label }}
        </a>
        <a class="patronb2b-btn patronb2b-btn--outline" href="{{ mail_url }}">
          {{ section.settings.mail_label }}
        </a>
      </div>
      <div class="patronb2b-hero-trust">
        {%- for block in section.blocks -%}
          <span {{ block.shopify_attributes }}>✓ {{ block.settings.text }}</span>
        {%- endfor -%}
      </div>
    </div>
    <div class="patronb2b-hero-media">
      {%- if section.settings.video != blank -%}
        {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
      {%- elsif section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'eager', sizes: '(max-width: 999px) 100vw, 50vw', widths: '600,900,1200,1500,1800', alt: section.settings.title }}
      {%- else -%}
        <div class="patronb2b-hero-media__dashed"></div>
        <div class="patronb2b-hero-media__placeholder">
          <div class="patronb2b-hero-media__play">
            <span aria-hidden="true" style="width:0;height:0;border-top:14px solid transparent;border-bottom:14px solid transparent;border-left:22px solid #fff;display:block;"></span>
          </div>
          <div class="patronb2b-hero-media__label">{{ section.settings.media_placeholder_label | default: 'Video folgt in Kürze' }}</div>
          <div class="patronb2b-hero-media__note">{{ section.settings.media_placeholder_note | default: 'Platzhalter – hier steht bald ein Video von der Idee bis zum fertigen Versand.' }}</div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Patron B2B – Hero",
  "class": "shopify-section--patronb2b-hero",
  "tag": "section",
  "settings": [
    {"type": "checkbox", "id": "full_width", "label": "Full width", "default": true},
    {"type": "color", "id": "background", "label": "Background", "default": "#FFFFFF"},
    {"type": "color", "id": "text_color", "label": "Text color", "default": "#1A1A1A"},
    {"type": "color", "id": "accent_color", "label": "Accent color", "default": "#632B99"},
    {"type": "color", "id": "media_bg", "label": "Media background", "default": "#42195A"},
    {"type": "text", "id": "subheading", "label": "Eyebrow", "default": "Corporate Gifts & Socks"},
    {"type": "text", "id": "title", "label": "Heading", "default": "Mehr als nur individuelle Socken."},
    {"type": "richtext", "id": "content", "label": "Lead", "default": "<p>Wir entwickeln komplette Geschenk- und Versandlösungen für Unternehmen, Vereine und Künstler – von der ersten Idee bis zum Versand an Kunden, Teams oder Fans.</p>"},
    {"type": "header", "content": "Primary Button (WhatsApp)"},
    {"type": "text", "id": "whatsapp_label", "label": "Label", "default": "Anfragen per WhatsApp"},
    {"type": "text", "id": "whatsapp_number", "label": "WhatsApp number", "default": "491627390598"},
    {"type": "textarea", "id": "whatsapp_message", "label": "Message", "default": "Hallo Patron Socks, wir interessieren uns für individuelle Werbesocken und möchten einen kostenlosen ersten Designvorschlag erhalten."},
    {"type": "color", "id": "primary_btn_bg", "label": "Background", "default": "#6DD972"},
    {"type": "color", "id": "primary_btn_text", "label": "Text", "default": "#1A1A1A"},
    {"type": "header", "content": "Secondary Button (Mail)"},
    {"type": "text", "id": "mail_label", "label": "Label", "default": "Anfragen per Mail"},
    {"type": "text", "id": "contact_email", "label": "Contact email", "default": "hello@patronsocks.de"},
    {"type": "text", "id": "mail_subject", "label": "Mail subject", "default": "Werbesocken Anfrage"},
    {"type": "header", "content": "Media"},
    {"type": "video", "id": "video", "label": "Video"},
    {"type": "image_picker", "id": "image", "label": "Fallback image"},
    {"type": "text", "id": "media_placeholder_label", "label": "Placeholder label", "default": "Video folgt in Kürze"},
    {"type": "text", "id": "media_placeholder_note", "label": "Placeholder note", "default": "Platzhalter – hier steht bald ein Video von der Idee bis zum fertigen Versand."}
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust badge",
      "limit": 6,
      "settings": [
        {"type": "text", "id": "text", "label": "Text", "default": "Designservice"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Patron B2B – Hero",
      "blocks": [
        {"type": "trust", "settings": {"text": "Designservice"}},
        {"type": "trust", "settings": {"text": "Geschenksets"}},
        {"type": "trust", "settings": {"text": "Einzelversand"}},
        {"type": "trust", "settings": {"text": "Persönliche Begleitung"}}
      ]
    }
  ]
}
{% endschema %}
