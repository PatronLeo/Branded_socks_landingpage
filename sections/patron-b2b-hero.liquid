{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} .patron-shell{width:min(var(--container-max-width),calc(100% - 40px));margin-inline:auto}
  #shopify-section-{{ section.id }} .patron-grid{display:grid;gap:var(--spacing-6)}
  #shopify-section-{{ section.id }} .patron-eyebrow{font-size:var(--text-xs);font-weight:700;letter-spacing:.12em;text-transform:uppercase}
  #shopify-section-{{ section.id }} .patron-muted{opacity:.68}
  #shopify-section-{{ section.id }} .patron-card{border:1px solid rgb(var(--text-color)/.12);border-radius:var(--rounded-lg);overflow:hidden}
  #shopify-section-{{ section.id }} .patron-media{position:relative;overflow:hidden;border-radius:var(--rounded-lg);min-height:420px}
  #shopify-section-{{ section.id }} .patron-media img,#shopify-section-{{ section.id }} .patron-media video{width:100%;height:100%;object-fit:cover;position:absolute;inset:0}
  @media screen and (max-width:699px){#shopify-section-{{ section.id }} .patron-shell{width:min(100% - 24px,var(--container-max-width))}}
</style>

<style>
#shopify-section-{{ section.id }} .patron-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:var(--spacing-12);align-items:center}
#shopify-section-{{ section.id }} .patron-hero__copy{padding-block:var(--spacing-14)}
#shopify-section-{{ section.id }} .patron-hero__title{max-width:13ch}
#shopify-section-{{ section.id }} .patron-hero__points{display:flex;flex-wrap:wrap;gap:10px 22px;margin-top:var(--spacing-6);font-size:var(--text-sm);font-weight:700}
#shopify-section-{{ section.id }} .patron-hero__media{min-height:650px}
#shopify-section-{{ section.id }} .patron-hero__caption{position:absolute;left:var(--spacing-8);right:var(--spacing-8);bottom:var(--spacing-8);z-index:2;color:#fff;font-size:clamp(24px,2.6vw,40px);font-weight:700;line-height:1.05}
#shopify-section-{{ section.id }} .patron-hero__media:after{content:'';position:absolute;inset:45% 0 0;background:linear-gradient(transparent,rgba(0,0,0,.68))}
@media(max-width:999px){#shopify-section-{{ section.id }} .patron-hero{grid-template-columns:1fr}#shopify-section-{{ section.id }} .patron-hero__media{min-height:500px}}
</style>
<div {% render 'section-properties' %}>
 <div class="patron-shell patron-hero">
  <div class="patron-hero__copy prose">
   {% if section.settings.subheading != blank %}<p class="subheading">{{ section.settings.subheading | escape }}</p>{% endif %}
   <h1 class="h1 patron-hero__title">{% render 'styled-text', content: section.settings.title, gradient: section.settings.heading_gradient %}</h1>
   {{ section.settings.content }}
   <div class="button-group">
    {% assign wa = section.settings.whatsapp_number | remove:' ' | remove:'+' | remove:'-' %}
    {% capture wa_url %}https://wa.me/{{ wa }}?text={{ section.settings.whatsapp_message | url_encode }}{% endcapture %}
    {% render 'button', href: wa_url, content: section.settings.whatsapp_label, size:'xl', background:section.settings.button_background, text_color:section.settings.button_text_color, external:true %}
    {% render 'button', href: section.settings.secondary_link, content: section.settings.secondary_label, size:'xl', style:'outline' %}
   </div>
   <div class="patron-hero__points"><span>✓ Designservice</span><span>✓ Geschenksets</span><span>✓ Einzelversand</span><span>✓ Persönliche Begleitung</span></div>
  </div>
  <div class="patron-media patron-hero__media" reveal-on-scroll="true">
   {% if section.settings.video != blank %}{{ section.settings.video | video_tag: autoplay:true, loop:true, muted:true, controls:false, playsinline:true }}
   {% elsif section.settings.image != blank %}{{ section.settings.image | image_url: width:1800 | image_tag: loading:'eager', sizes:'(max-width:999px) 100vw, 50vw', widths:'600,900,1200,1500,1800' }}
   {% else %}{{ 'lifestyle-1' | placeholder_svg_tag:'placeholder' }}{% endif %}
   <div class="patron-hero__caption">{{ section.settings.media_caption }}</div>
  </div>
 </div>
</div>
{% schema %}
{
 "name":"Patron – Hero",
 "class":"shopify-section--patron-hero","tag":"section",
 "settings":[
  {"type":"checkbox","id":"full_width","label":"Full width","default":true},
  {"type":"color","id":"background","label":"Background","default":"#f2eee7"},
  {"type":"color_background","id":"background_gradient","label":"Background gradient"},
  {"type":"color","id":"text_color","label":"Text","default":"#121212"},
  {"type":"text","id":"subheading","label":"Subheading","default":"Corporate Gifts & Socks"},
  {"type":"text","id":"title","label":"Heading","default":"Mehr als nur individuelle Socken."},
  {"type":"richtext","id":"content","label":"Content","default":"<p>Wir entwickeln komplette Geschenk- und Versandlösungen für Unternehmen, Vereine und Künstler – von der ersten Idee bis zum Versand an Kunden, Teams oder Fans.</p>"},
  {"type":"video","id":"video","label":"Shopify video"},{"type":"image_picker","id":"image","label":"Fallback image"},
  {"type":"text","id":"media_caption","label":"Media caption","default":"Von der Idee bis zum besonderen Moment."},
  {"type":"text","id":"whatsapp_number","label":"WhatsApp number","default":"491234567890"},
  {"type":"textarea","id":"whatsapp_message","label":"WhatsApp message","default":"Hallo Patron Socks, wir möchten einen kostenlosen ersten Designvorschlag erhalten."},
  {"type":"text","id":"whatsapp_label","label":"WhatsApp button","default":"Logo per WhatsApp senden"},
  {"type":"color","id":"button_background","label":"Button background","default":"#25d366"},{"type":"color","id":"button_text_color","label":"Button text","default":"#121212"},
  {"type":"text","id":"secondary_label","label":"Secondary button","default":"Kostenlosen Entwurf erhalten"},{"type":"text","id":"secondary_link","label":"Secondary link / anchor","default":"#patron-b2b-contact"},
  {"type":"color_background","id":"heading_gradient","label":"Heading gradient"}
 ],"presets":[{"name":"Patron – Hero"}]
}
{% endschema %}
